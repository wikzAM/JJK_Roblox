      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">GlassConfig</string>
          <string name="Source"><![CDATA[-- Shared asset IDs and performance/art tuning. No runtime actions.
local C={}
C.VERSION=1
C.State={Intact=1,Cracked=2,Shattered=3,Removed=4}
C.CrackImage="rbxassetid://91345378258372"
C.ShatteredImage="rbxassetid://118715470275244"
C.BackupCrackDecal="rbxassetid://111911787795227" -- owner-supplied store asset; not needed by current uploads
C.CrackTileStuds=12
C.EdgeThicknessStuds=1.0
C.PaneStuds=12
-- Temporary opt-in trial. This is not the final per-floor facade art policy.
C.GeneratedFacadeScope="groundPilot" -- "city" must be an explicit later rollout
C.GeneratedUpperEnabled=false -- Larger trial is ground-only; future upper families opt in.
C.FarProxyEnabled=false -- opaque coloured stand-ins are unsuitable for this trial
C.NearRadius=700
C.DropRadius=850
C.DetailRadius=220
C.FarRadius=1700
C.FarDropRadius=1900
C.FrameBudget=0.002
C.MaxBuildSpeed=400
C.MaxPooledParts=1800
C.MaxShardsPerEvent=48
C.MaxVFXRowsPerEvent=16 -- Transient shard geometry; full damage still lives in state pages.
C.MaxLiveShardParticles=192
C.ShardImage="rbxassetid://95153642216404"
C.ShardsPerPane=3
C.ShardLifetime=3
C.DefaultCrackBand=6
C.DestructionClearance=12 -- remove a full pane-width beyond the structural cutter
C.DestructionCrackBand=12 -- cracked glass starts outside that cleared margin
C.ShatterSpeed=65 -- illustrative impact speed threshold, studs/s; attacks may supply explicit states
return C
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">GlassVisual</string>
          <string name="Source"><![CDATA[-- Four glass states on an ordinary Part. Textures are presentation, not physics.
local Config=require(script.Parent.GlassConfig)
local V={}
local S=Config.State
local PREFIX="GlassDamage_"
local function textureContent(texture,uri)
	-- Current content API; compatibility for older Studio builds.
	local ok=pcall(function()texture.ColorMapContent=Content.fromUri(uri)end)
	if not ok then texture.Texture=uri end
end
function V.ClearTextures(part)
	for _,o in part:GetChildren() do if o:IsA("Decal") and o.Name:sub(1,#PREFIX)==PREFIX then o:Destroy() end end
end
function V.Capture(part,id,collision)
	if part:GetAttribute("GlassBaseTransparency")==nil then
		part:SetAttribute("GlassBaseTransparency",part.Transparency)
		part:SetAttribute("GlassBaseReflectance",part.Reflectance)
		part:SetAttribute("GlassBaseR",part.Color.R);part:SetAttribute("GlassBaseG",part.Color.G);part:SetAttribute("GlassBaseB",part.Color.B)
		local intact=collision;if intact==nil then intact=part.CanCollide end
		part:SetAttribute("GlassIntactCollision",intact)
	end
	if id then part:SetAttribute("GlassPaneId",id) end
	if part:GetAttribute("GlassState")==nil then part:SetAttribute("GlassState",S.Intact) end
	part:AddTag("GlassPane")
end
local function baseline(part)
	return Color3.new(part:GetAttribute("GlassBaseR") or part.Color.R,part:GetAttribute("GlassBaseG") or part.Color.G,part:GetAttribute("GlassBaseB") or part.Color.B)
end
local function cracks(part)
	for _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do
		local t=Instance.new("Texture");t.Name=PREFIX.."Cracks";t.Face=face
		textureContent(t,Config.CrackImage)
		t.StudsPerTileU=Config.CrackTileStuds;t.StudsPerTileV=Config.CrackTileStuds
		-- Offsets vary per physical pane, stable across rebuilds.
		local h=0;for c in (part:GetAttribute("GlassPaneId") or part.Name):gmatch(".") do h=(h*33+string.byte(c))%997 end
		t.OffsetStudsU=(h%12)*.5;t.OffsetStudsV=(math.floor(h/12)%12)*.5
		t.Transparency=.08;t.Parent=part
	end
end
local function brokenEdges(part)
 -- Cropped, fixed-scale strips. Explicit short ImageLabels avoid the engine's
 -- Tile + ImageRect interaction (which sampled the wrong border in Studio).
 for _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do
  local gui=Instance.new("SurfaceGui");gui.Name=PREFIX.."Edges";gui.Face=face
  gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud;gui.PixelsPerStud=36
  gui.LightInfluence=.15;gui.MaxDistance=350;gui.Parent=part
  local w,h=part.Size.X,part.Size.Y
  local t=math.min(Config.EdgeThicknessStuds,w*.20,h*.20)
  -- Roblox transcoded this upload to 1024px; crop in uploaded pixels.
  local n,band=1024,155
  local function image(name,x,y,sx,sy,ox,oy,rx,ry)
   local im=Instance.new("ImageLabel");im.Name=name;im.BackgroundTransparency=1
   im.Size=UDim2.fromScale(sx/w,sy/h);im.Position=UDim2.fromScale(x/w,y/h)
   im.Image=Config.ShatteredImage;im.ImageTransparency=.12
   im.ImageRectOffset=Vector2.new(ox,oy);im.ImageRectSize=Vector2.new(rx,ry)
   im.ScaleType=Enum.ScaleType.Stretch;im.Parent=gui
  end
  for _,corner in {{0,0,0,0},{w-t,0,n-band,0},{0,h-t,0,n-band},{w-t,h-t,n-band,n-band}} do
   image("Corner",corner[1],corner[2],t,t,corner[3],corner[4],band,band)
  end
  local span=(n-2*band)/band*t
  local nx=math.max(1,math.ceil((w-2*t)/span));local dx=(w-2*t)/nx
  for i=1,nx do
   image("Top",t+(i-1)*dx,0,dx,t,band,0,n-2*band,band)
   image("Bottom",t+(i-1)*dx,h-t,dx,t,band,n-band,n-2*band,band)
  end
  local ny=math.max(1,math.ceil((h-2*t)/span));local dy=(h-2*t)/ny
  for i=1,ny do
   image("Left",0,t+(i-1)*dy,t,dy,0,band,band,n-2*band)
   image("Right",w-t,t+(i-1)*dy,t,dy,n-band,band,band,n-2*band)
  end
 end
end
local function clearEdges(part)
	for _,o in part:GetChildren() do if o.Name==PREFIX.."Edges" then o:Destroy() end end
end
function V.Apply(part,state,options)
	options=options or {}
	assert(type(state)=="number" and state%1==0 and state>=1 and state<=4,"Invalid glass state")
	V.Capture(part)
	V.ClearTextures(part);clearEdges(part)
	part:SetAttribute("GlassState",state)
	if state==S.Removed then part:Destroy();return end
	part.Material=Enum.Material.Glass
	part.Color=baseline(part)
	part.CanCollide=state<=S.Cracked and part:GetAttribute("GlassIntactCollision")==true
	part.CanTouch=false
	part.Transparency=state==S.Shattered and 1 or part:GetAttribute("GlassBaseTransparency")
	part.Reflectance=state==S.Shattered and 0 or part:GetAttribute("GlassBaseReflectance")
	if options.serverPhysics then part.CanQuery=state<=S.Cracked end
	for _,o in part:GetChildren() do
		if o:IsA("BasePart") and (o.Name=="PrivacyFilm" or o:GetAttribute("GlassAttachedOverlay")) then
			if o:GetAttribute("GlassFilmTransparency")==nil then o:SetAttribute("GlassFilmTransparency",o.Transparency) end
			o.Transparency=state==S.Shattered and 1 or o:GetAttribute("GlassFilmTransparency")
			o.CanCollide=false;o.CanQuery=false
			for _,g in o:GetChildren() do if g:IsA("SurfaceGui") then g.Enabled=state~=S.Shattered end end
		end
	end
	if options.textures~=false then
		if state==S.Cracked then cracks(part)
		elseif state==S.Shattered then brokenEdges(part) end
	end
end
function V.ResetPooled(part)
	V.ClearTextures(part);clearEdges(part)
	part:RemoveTag("GlassPane")
	for key in part:GetAttributes() do if key:sub(1,5)=="Glass" then part:SetAttribute(key,nil) end end
end
return V
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">GroundFacadeCatalog</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Draft street-level kit, October 8, 2026. No runtime or city mutations.
-- Single-storey types fit existing tuning; tall types explicitly occupy two storeys.
local Names = require(script.Parent.GroundFacadeNames)
local Catalog = {}
Catalog.VERSION = 6
Catalog.PALETTES = {
	stone = {wall=Color3.fromRGB(179,175,165), trim=Color3.fromRGB(43,47,48), accent=Color3.fromRGB(178,146,86)},
	cream = {wall=Color3.fromRGB(219,210,187), trim=Color3.fromRGB(62,54,45), accent=Color3.fromRGB(101,121,98)},
	charcoal = {wall=Color3.fromRGB(63,66,69), trim=Color3.fromRGB(26,29,32), accent=Color3.fromRGB(191,162,110)},
	brick = {wall=Color3.fromRGB(129,87,70), trim=Color3.fromRGB(40,43,45), accent=Color3.fromRGB(220,207,177)},
	grey = {wall=Color3.fromRGB(163,162,165), trim=Color3.fromRGB(74,78,80), accent=Color3.fromRGB(123,133,133)},
}
-- Widths vary within a type's fit range; doors, handles and trim stay human-scale.
Catalog.TYPES = {
	{id="01_Konbini", title="Convenience shop", family="retail", width=36, minWidth=28, maxWidth=48, palette="stone", brand="まちマート / MACHI MART", subtitle="24H  /  DAILY GOODS", feature="stripe", accent=Color3.fromRGB(45,129,114), door="slide", depth=1.2},
	{id="02_Coffee", title="Neighbourhood coffee", family="retail", width=28, minWidth=22, maxWidth=38, palette="cream", brand="喫茶 なぎ / NAGI", subtitle="COFFEE  &  TEA", feature="awning", accent=Color3.fromRGB(70,99,88), door="single", depth=1.4},
	{id="03_Ramen", title="Ramen ticket shop", family="food", width=20, minWidth=18, maxWidth=28, palette="charcoal", brand="麺処 あお / AO RAMEN", subtitle="らーめん  /  RAMEN", feature="noren", accent=Color3.fromRGB(154,47,39), door="slide", depth=1.4},
	{id="04_Izakaya", title="Timber izakaya", family="food", width=24, minWidth=20, maxWidth=32, palette="charcoal", brand="酒場 こま / KOMA", subtitle="小皿とお酒  /  IZAKAYA", feature="lattice", accent=Color3.fromRGB(169,117,63), door="slide", depth=1.8},
	{id="05_Bakery", title="Brick bakery", family="retail", width=28, minWidth=22, maxWidth=38, palette="brick", brand="こむぎ / KOMUGI", subtitle="BAKERY  /  FRESH DAILY", feature="bakery", accent=Color3.fromRGB(197,157,89), door="single", depth=1.2},
	{id="06_Boutique", title="Recessed fashion boutique", family="retail", width=32, minWidth=24, maxWidth=44, palette="cream", brand="余白 / YOHAKU", subtitle="CLOTHING  &  OBJECTS", feature="display", accent=Color3.fromRGB(182,168,142), door="double", depth=2.6},
	{id="07_Showroom", title="Glass flagship showroom", family="retail", width=36, minWidth=28, maxWidth=48, palette="charcoal", brand="FRAME / フレーム", subtitle="DESIGN  /  STUDIO", feature="showroom", accent=Color3.fromRGB(188,197,206), door="double", depth=2.2},
	{id="08_Pharmacy", title="Neighbourhood pharmacy", family="retail", width=32, minWidth=24, maxWidth=44, palette="stone", brand="あさひ薬局 / ASAHI", subtitle="薬  /  PHARMACY", feature="pharmacy", accent=Color3.fromRGB(61,122,157), door="slide", depth=1.2},
	{id="09_Shutter", title="Closed tenant shutter", family="service", width=24, minWidth=16, maxWidth=36, palette="stone", brand="貸店舗 / TO LET", subtitle="RETAIL SPACE", feature="shutter", accent=Color3.fromRGB(104,113,122), door="none", depth=0.6},
	{id="10_TenantEntry", title="Upper-floor tenant entry", family="entry", width=16, minWidth=14, maxWidth=22, palette="charcoal", brand="青葉ビル / AOBA BLDG", subtitle="2F CAFE  /  3F STUDIO  /  4F OFFICE", feature="directory", accent=Color3.fromRGB(174,181,180), door="double", depth=3.0},
	{id="11_OfficeStone", title="Stone office lobby", family="office", width=40, minWidth=30, maxWidth=52, palette="stone", brand="南青山 / MINAMI OFFICE", subtitle="OFFICE ENTRANCE", feature="stoneLobby", accent=Color3.fromRGB(160,137,91), door="double", depth=3.2},
	{id="12_OfficeGlass", title="Glass office reception", family="office", width=48, minWidth=36, maxWidth=60, palette="charcoal", brand="SAKURA / WORKPLACE", subtitle="LOBBY  /  RECEPTION", feature="glassLobby", accent=Color3.fromRGB(115,142,151), door="slide", depth=2.8},
	{id="13_HotelCanopy", title="Business hotel canopy", family="hotel", width=48, minWidth=36, maxWidth=60, palette="charcoal", brand="HOTEL TSUKI / 月", subtitle="ENTRANCE  /  RECEPTION", feature="hotel", accent=Color3.fromRGB(176,148,98), door="slide", depth=3.4},
	{id="14_HotelTimber", title="Small timber hotel", family="hotel", width=32, minWidth=26, maxWidth=42, palette="cream", brand="HOTEL MORI / 森", subtitle="STAY  /  LOUNGE", feature="timberHotel", accent=Color3.fromRGB(123,92,61), door="double", depth=2.8},
	{id="15_Residential", title="Apartment lobby and mail", family="residential", width=24, minWidth=20, maxWidth=34, palette="stone", brand="桜レジデンス / SAKURA", subtitle="RESIDENCE  /  PRIVATE ENTRY", feature="mail", accent=Color3.fromRGB(101,113,111), door="single", depth=2.4},
}
-- Screenshot-led expansion: physical openings/materials/circulation, not sign reskins.
local additions = {
	{"16_ChainBurger","Wood-clad chain restaurant","food",36,30,48,"brick","burger","ひかりバーガー / HIKARI BURGER"},
	{"17_ChainGrille","Twin restaurant security grilles","food",48,40,60,"charcoal","grille","まちキッチン / MACHI KITCHEN"},
	{"18_PosterKonbini","Poster-dense sliding convenience shop","retail",32,28,44,"stone","posterShop","まちストア / MACHI STORE"},
	{"19_LocalShop","Tiled Japanese local shop","retail",22,20,30,"cream","localShop","つむぎ商店"},
	{"20_ProduceShop","Open-front greengrocer","retail",30,26,40,"cream","produce","青葉青果"},
	{"21_TakeawayHatch","Concrete takeaway serving hatch","food",22,20,30,"stone","hatch","こはる弁当"},
	{"22_HairSalon","Frosted salon with inset entry","retail",28,24,38,"cream","salon","凪音美容室 / NAGINE"},
	{"23_Electronics","Boxed display and repair shop","retail",28,24,38,"charcoal","electronics","みなと電気"},
	{"24_ConcreteSparse","Plain concrete, high windows, steel door","service",30,24,44,"stone","sparse",""},
	{"25_ConcreteDouble","Concrete service front, two doors","service",32,28,44,"stone","servicePair",""},
	{"26_BrickResidential","Brick residence, frost and planted edge","residential",28,24,38,"cream","brickHome","桜レジデンス"},
	{"27_TownhouseColumns","Townhouse columns and privacy fins","residential",24,22,34,"charcoal","townhouse",""},
	{"28_ApartmentGate","Low wall and gated apartment approach","residential",32,28,44,"cream","gateHome","青葉ハウス"},
	{"29_RaisedEntry","Garage shutter and separate raised entry","residential",32,30,44,"cream","raised","楓ハウス"},
	{"30_OpenGarage","Single open concrete parking bay","parking",28,22,40,"stone","garage",""},
	{"31_TwinGarage","Two open bays, central pier","parking",44,36,60,"cream","twinGarage",""},
	{"32_PilotisParking","Open pilotis with round columns","parking",48,40,60,"stone","pilotis",""},
	{"33_LoadingBay","Open loading portal and service entry","service",40,34,52,"charcoal","loading","搬入口 / DELIVERY"},
	{"34_TwoStoreyGlass","Two-storey glazing with ribbed spandrel","office",44,36,60,"charcoal","stackedGlass","AOBA / WORKPLACE"},
	{"35_DoubleHeightGlass","Double-height point-fixed glass vestibule","office",48,40,60,"stone","tallGlass","SAKURA / LOBBY"},
	{"36_McDooDoos","McDooDoo's red canopy restaurant","food",36,28,48,"charcoal","fastFood","McDooDoo's"},
	{"37_SmashKing","Smash King brick and timber burger shop","food",36,28,48,"brick","kingBurger","SMASH KING"},
	{"38_Starboys","Starboys green coffee and timber fins","retail",32,26,44,"cream","coffeeChain","STARBOYS"},
}
for _,a in additions do
	local tall=a[8]=="stackedGlass" or a[8]=="tallGlass"
	table.insert(Catalog.TYPES,{id=a[1],title=a[2],family=a[3],width=a[4],minWidth=a[5],maxWidth=a[6],
		palette=a[7],feature=a[8],brand=a[9],subtitle="",generation=2,height=tall and 29.5 or 12.5,
		minHeight=tall and 27.5 or (a[8]=="raised" and 11.5 or 10.5),maxHeight=tall and 36 or 24,floorSpan=tall and 2 or 1,
		requiresVoid=a[8]=="tallGlass",depth=2})
end
-- Quiet sides/back faces are physical designs too, with no default shop identity.
local perimeter = {
	{"39_PlainConcrete","Blank grey concrete wall","service",24,2,48,"grey","plainWall",true},
	{"40_PanelSeams","Concrete panels with recessed seams","service",28,8,48,"grey","panelWall",true},
	{"41_HighSlit","High horizontal privacy window","service",24,12,40,"grey","highSlit",true},
	{"42_PairedFrost","Two modest frosted residential windows","residential",24,16,40,"stone","pairedFrost",true},
	{"43_UtilityWall","Vent and drainpipe service wall","service",24,12,40,"grey","utilityWall",true},
	{"44_RearSteelDoor","Quiet rear steel door and small transom","service",20,14,34,"grey","rearDoor",true},
	{"45_TiledBoundary","Tiled wall with low ledge and inset window","residential",28,18,42,"cream","tiledWall",true},
	{"46_Laundry","Laundry with split transom and machine display","retail",28,24,40,"stone","laundry",false},
	{"47_BicycleRepair","Cycle repair shutter and workshop glazing","service",28,24,40,"charcoal","bicycle",false},
	{"48_Florist","Timber flower shop and recessed display shelves","retail",26,24,38,"cream","florist",false},
	{"49_Clinic","Pale clinic with opaque privacy panels","service",30,26,42,"stone","clinic",false},
	{"50_Bookshop","Deep framed bookshop with display pilasters","retail",28,24,40,"brick","bookshop",false},
	{"51_SobaShop","Soba shop with half wall and narrow noren","food",24,22,34,"charcoal","soba",false},
	{"52_Bathhouse","Tiled bathhouse-style split entrance","service",32,28,44,"stone","bathhouse",false},
	{"53_TimberHouse","Quiet timber house with projecting screen","residential",24,22,36,"cream","timberHouse",false},
}
for _,a in perimeter do
	local identity=not a[9] and Names.Generate(a[3],a[1],{feature=a[8]}) or nil
	table.insert(Catalog.TYPES,{id=a[1],title=a[2],family=a[3],width=a[4],minWidth=a[5],maxWidth=a[6],palette=a[7],feature=a[8],signless=a[9],brand=identity and identity.brand or "",subtitle=identity and identity.subtitle or "",generation=3,height=12.5,minHeight=10.5,maxHeight=24,floorSpan=1,depth=1.5})
end
-- Art-direction weights, not a measured census. No random storefronts on a landmark.
Catalog.PROFILES = {
	mixed = {{"01_Konbini",2},{"02_Coffee",3},{"03_Ramen",2},{"04_Izakaya",2},{"05_Bakery",2},{"06_Boutique",3},{"07_Showroom",1},{"08_Pharmacy",1},{"09_Shutter",1}},
	retail = {{"01_Konbini",2},{"02_Coffee",2},{"05_Bakery",2},{"06_Boutique",4},{"07_Showroom",2},{"08_Pharmacy",1}},
	alley = {{"03_Ramen",4},{"04_Izakaya",4},{"09_Shutter",2},{"02_Coffee",1}},
	office = {{"11_OfficeStone",1},{"12_OfficeGlass",1}},
	hotel = {{"13_HotelCanopy",1},{"14_HotelTimber",1}},
	residential = {{"15_Residential",1}},
}
Catalog.PROFILES.mixed = {{"01_Konbini",2},{"02_Coffee",2},{"03_Ramen",2},{"04_Izakaya",2},{"05_Bakery",1},{"06_Boutique",2},{"09_Shutter",1},{"16_ChainBurger",2},{"17_ChainGrille",1},{"18_PosterKonbini",2},{"19_LocalShop",3},{"20_ProduceShop",1},{"21_TakeawayHatch",2},{"22_HairSalon",2},{"23_Electronics",1},{"24_ConcreteSparse",1},{"26_BrickResidential",1},{"30_OpenGarage",1}}
Catalog.PROFILES.retail = {{"01_Konbini",2},{"02_Coffee",2},{"05_Bakery",1},{"06_Boutique",2},{"07_Showroom",1},{"08_Pharmacy",1},{"18_PosterKonbini",3},{"19_LocalShop",3},{"20_ProduceShop",1},{"22_HairSalon",2},{"23_Electronics",2}}
Catalog.PROFILES.alley = {{"03_Ramen",3},{"04_Izakaya",3},{"09_Shutter",2},{"19_LocalShop",2},{"21_TakeawayHatch",2},{"24_ConcreteSparse",2},{"25_ConcreteDouble",1},{"30_OpenGarage",2}}
Catalog.PROFILES.residential = {{"15_Residential",1},{"26_BrickResidential",3},{"27_TownhouseColumns",2},{"28_ApartmentGate",2}}
Catalog.PROFILES.residentialStreet = {{"24_ConcreteSparse",2},{"26_BrickResidential",3},{"27_TownhouseColumns",3},{"28_ApartmentGate",2},{"29_RaisedEntry",2},{"30_OpenGarage",2},{"31_TwinGarage",1}}
Catalog.PROFILES.parking = {{"30_OpenGarage",3},{"31_TwinGarage",2},{"32_PilotisParking",1}}
Catalog.PROFILES.service = {{"24_ConcreteSparse",3},{"25_ConcreteDouble",2},{"33_LoadingBay",1},{"09_Shutter",2}}
-- Tall types are opt-in: never picked for an ordinary ground storey.
Catalog.PROFILES.twoStorey = {{"34_TwoStoreyGlass",1}}
Catalog.PROFILES.atrium = {{"35_DoubleHeightGlass",1}}
Catalog.PROFILES.chains = {{"36_McDooDoos",1},{"37_SmashKing",1},{"38_Starboys",1}}
table.insert(Catalog.PROFILES.mixed,{"36_McDooDoos",1})
table.insert(Catalog.PROFILES.mixed,{"37_SmashKing",1})
table.insert(Catalog.PROFILES.retail,{"38_Starboys",1})
Catalog.PROFILES.blind = {{"39_PlainConcrete",5},{"40_PanelSeams",3},{"43_UtilityWall",1},{"45_TiledBoundary",1}}
Catalog.PROFILES.window = {{"41_HighSlit",3},{"42_PairedFrost",3},{"45_TiledBoundary",2},{"40_PanelSeams",1}}
Catalog.PROFILES.backStreet = {{"39_PlainConcrete",2},{"40_PanelSeams",2},{"41_HighSlit",2},{"42_PairedFrost",2},{"43_UtilityWall",2},{"44_RearSteelDoor",1},{"45_TiledBoundary",1}}
Catalog.PROFILES.tokyo = {{"46_Laundry",2},{"47_BicycleRepair",1},{"48_Florist",2},{"49_Clinic",1},{"50_Bookshop",2},{"51_SobaShop",3},{"52_Bathhouse",1},{"53_TimberHouse",2}}
for _,id in {"46_Laundry","48_Florist","50_Bookshop"} do table.insert(Catalog.PROFILES.retail,{id,1});table.insert(Catalog.PROFILES.mixed,{id,1}) end
for _,id in {"47_BicycleRepair","49_Clinic","52_Bathhouse"} do table.insert(Catalog.PROFILES.service,{id,1}) end
table.insert(Catalog.PROFILES.mixed,{"51_SobaShop",2})
table.insert(Catalog.PROFILES.residential,{"53_TimberHouse",2})
function Catalog.Get(id)
	for _, spec in Catalog.TYPES do if spec.id == id then return spec end end
	error("Unknown ground facade: "..tostring(id))
end
function Catalog.Seed(key)
	local h = 5381
	for i=1,#key do h=(h*33+string.byte(key,i))%2147483647 end
	return h
end
-- Fictional identities, independent of the physical template choice.
Catalog.NAMES = {
	{"青葉","AOBA"},{"なぎ","NAGI"},{"こま","KOMA"},{"森","MORI"},{"月","TSUKI"},
	{"桜","SAKURA"},{"あさひ","ASAHI"},{"ひかり","HIKARI"},{"空","SORA"},{"楓","KAEDE"},
	{"こはる","KOHARU"},{"つむぎ","TSUMUGI"},{"みなと","MINATO"},{"凪音","NAGINE"},{"余白","YOHAKU"},
}
function Catalog.Brand(id,key,nameSeed)
	local s=Catalog.Get(id)
	if s.signless or s.family=="parking" or s.feature=="sparse" or s.feature=="servicePair" or s.feature=="townhouse" then return "" end
	if s.feature=="loading" then return "搬入口 / DELIVERY" end
	if s.feature=="shutter" then return "貸店舗 / TO LET" end
	return Names.Generate(s.family,key,{feature=s.feature,nameSeed=nameSeed}).brand
end
function Catalog.Pick(profile, key, width, height)
	local rows=assert(Catalog.PROFILES[profile], "Unknown facade profile")
	local eligible,total={},0
	for _,row in rows do
		local s=Catalog.Get(row[1])
		if width>=s.minWidth and width<=s.maxWidth and (not height or (height>=(s.minHeight or 10.5) and height<=(s.maxHeight or 24))) then total+=row[2]; table.insert(eligible,row) end
	end
	if total==0 then return nil end
	local roll=Random.new(Catalog.Seed(key)):NextNumber()*total
	for _,row in eligible do roll-=row[2]; if roll<=0 then return Catalog.Get(row[1]) end end
	return Catalog.Get(eligible[#eligible][1])
end
return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">GroundFacadeExpansion</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Native-part interpretations of the owner's October 8 Shibuya photographs.
-- Pure layout data. No terrain, building discovery, runtime hooks, or external assets.
local Catalog=require(script.Parent.GroundFacadeCatalog)
local E={}
local M=Enum.Material
local GLASS=Color3.fromRGB(111,139,143)
local WHITE=Color3.fromRGB(235,233,221)
local WOOD=Color3.fromRGB(127,94,63)
local POSTERS={
	{"新発売\nお弁当",Color3.fromRGB(192,61,45)}, {"ランチ\nセット",Color3.fromRGB(218,162,46)},
	{"営業中\nOPEN",Color3.fromRGB(51,114,92)}, {"おすすめ\n珈琲",Color3.fromRGB(69,101,145)},
	{"お持ち帰り\nできます",Color3.fromRGB(180,86,94)}, {"本日の\nおすすめ",Color3.fromRGB(83,124,128)},
	{"新商品\n入荷",Color3.fromRGB(153,84,49)}, {"毎日\nできたて",Color3.fromRGB(97,105,61)},
}
local function finite(v) return type(v)=="number" and v==v and math.abs(v)<1e12 end

function E.Layout(spec,options)
	options=options or {}
	local w,h=options.width or spec.width,options.height or spec.height
	assert(finite(w) and w>=spec.minWidth and w<=spec.maxWidth,"Width outside type fit range")
	assert(finite(h) and h>=spec.minHeight and h<=spec.maxHeight,"Height outside type fit range")
	local role=options.role or "entrance"
	if options.allowEntrance==false and role=="entrance" then role="window" end
	assert(role=="entrance" or role=="window" or role=="blind","Unknown facade role")
	local seed=options.seed or Catalog.Seed(spec.id)
	assert(finite(seed),"Invalid seed")
	local rng=Random.new(seed)
	local pal=assert(Catalog.PALETTES[options.palette or spec.palette],"Unknown palette")
	local accent=options.accent or (spec.family=="food" and Color3.fromRGB(174,48,40) or pal.accent)
	local f=spec.feature
	if f=="fastFood" then accent=Color3.fromRGB(182,43,41)
	elseif f=="kingBurger" then accent=Color3.fromRGB(142,51,32)
	elseif f=="coffeeChain" then accent=Color3.fromRGB(28,99,77) end
	local out={id=spec.id,width=w,height=h,seed=seed,role=role,parts={},portals={},floorSpan=spec.floorSpan,requiresVoid=spec.requiresVoid}
	local function p(name,x,y,z,sx,sy,sz,c,mat,kind,t,rot,shape)
		assert(sx>=.05 and sy>=.05 and sz>=.05,"Undersize part: "..name)
		local row={name=name,cframe=CFrame.new(x,y,z)*(rot or CFrame.identity),size=Vector3.new(sx,sy,sz),
			color=c or pal.wall,material=mat or M.Concrete,kind=kind or "trim",transparency=t or 0,shape=shape}
		table.insert(out.parts,row);return row
	end
	local function sign(name,x,y,z,sx,sy,value,bg,ink)
		if value=="" then return end
		local row=p(name,x,y,z,sx,sy,.10,bg or accent,M.SmoothPlastic,"sign")
		row.text=value;row.ink=ink or WHITE;row.face=Enum.NormalId.Front;return row
	end
	local function wall(name,x0,x1,y0,y1,z,depth,mat)
		if x1-x0>=.05 and y1-y0>=.05 then p(name,(x0+x1)/2,(y0+y1)/2,z,x1-x0,y1-y0,depth or .7,pal.wall,mat or M.Concrete,"wall") end
	end
	local function pier(x,width) wall("ConcretePier",x-width/2,x+width/2,0,h,0,.9) end
	local function portal(x,width,y0,height,depth,name)
		table.insert(out.portals,{x=x,width=width,y=y0,height=height,recess=depth,name=name or "entry"})
	end
	local function door(x,width,y0,height,z,opaque)
		local leaves=width>5.5 and 2 or 1
		for i=1,leaves do
			local lw=width/leaves;local cx=x-width/2+(i-.5)*lw
			p(opaque and "SteelDoorLeaf" or "EntryGlazing",cx,y0+height/2,z,lw-.16,height-.08,.18,opaque and pal.trim or GLASS,opaque and M.Metal or M.Glass,"door",opaque and 0 or .34)
			for _,dx in {-lw/2+.08,lw/2-.08} do p("EntryStile",cx+dx,y0+height/2,z-.14,.16,height,.24,pal.trim,M.Metal) end
			p("EntryTopRail",cx,y0+height-.1,z-.14,lw,.2,.25,pal.trim,M.Metal)
			p("EntryBottomRail",cx,y0+.2,z-.14,lw,.35,.25,pal.trim,M.Metal)
			p("EntryHandle",cx+lw*.30,y0+4,z-.34,.12,1.4,.16,WHITE,M.Metal)
		end
		for _,dx in {-width/2-.1,width/2+.1} do p("InsetDoorJamb",x+dx,y0+height/2,z/2,.2,height,z+.4,pal.trim,M.Metal) end
		p("InsetDoorSoffit",x,y0+height,z/2,width+.4,.2,z+.4,pal.trim,M.Metal)
		p("EntryThreshold",x,y0+.08,z/2,width,.16,z+.4,pal.wall,M.Concrete,"threshold")
		portal(x,width,y0,height,z)
		out.door=out.door or {x=x,width=width,y=y0,height=height,recess=z,interactive=false}
	end
	local function glass(x0,x1,y0,y1,z,frost)
		if x1-x0<.6 or y1-y0<.6 then return end
		local n=math.max(1,math.ceil((x1-x0)/7));local span=(x1-x0)/n
		for i=1,n do
			p("WindowPane",x0+(i-.5)*span,(y0+y1)/2,z,span-.16,y1-y0,.18,GLASS,M.Glass,"glass",frost and .13 or .36)
			if frost then p("PrivacyFilm",x0+(i-.5)*span,y0+(y1-y0)*.32,z-.11,span-.22,(y1-y0)*.62,.05,WHITE,M.SmoothPlastic,"glass",.2) end
			if i<n then p("WindowMullion",x0+i*span,(y0+y1)/2,z-.14,.20,y1-y0,.24,pal.trim,M.Metal) end
		end
		-- Overlap the .08 pane inset; a visible window cannot have open perimeter slits.
		for _,x in {x0,x1} do p("WindowEndStile",x,(y0+y1)/2,z-.14,.20,y1-y0,.24,pal.trim,M.Metal) end
		for _,y in {y0,y1} do p("WindowRail",(x0+x1)/2,y,z-.12,x1-x0,.16,.28,pal.trim,M.Metal) end
	end
	-- Rectangle decomposition creates actual holes in an opaque front.
	local function concrete(holes,mat)
		local xs={-w/2,w/2};local ys={0,h}
		for _,q in holes do table.insert(xs,q[1]);table.insert(xs,q[2]);table.insert(ys,q[3]);table.insert(ys,q[4]) end
		table.sort(xs);table.sort(ys)
		for i=1,#xs-1 do for j=1,#ys-1 do
			local cx,cy=(xs[i]+xs[i+1])/2,(ys[j]+ys[j+1])/2;local empty=false
			for _,q in holes do if cx>q[1] and cx<q[2] and cy>q[3] and cy<q[4] then empty=true;break end end
			if not empty then wall("OpaqueFront",xs[i],xs[i+1],ys[j],ys[j+1],0,.75,mat) end
		end end
	end
	local function canopy(x,width,y,depth,color)
		p("ProjectingCanopy",x,y,-depth/2,width,.35,depth,color or pal.trim,M.Metal)
		p("SoffitStrip",x,y-.23,-depth+.4,width-.8,.1,.16,Color3.fromRGB(229,211,176),M.Neon,"light")
	end
	local function planter(x,z,width)
		local group="planter/"..tostring(#out.parts+1)
		local box=p("PlantedEdgeBox",x,.6,z,width,1.2,1.8,pal.wall,M.Brick,"prop")
		box.supportGroup=group;box.supportBase=true;box.supportLocalBottom=Vector3.new(x,0,z)
		local plant=p("ClippedPlanting",x,1.7,z,width-.2,1.2,1.6,Color3.fromRGB(60,86,56),M.Grass,"prop")
		plant.supportGroup=group
	end
	-- Ad stream is independently seeded. Shape selection and entrance never move with adSeed.
	local ads=options.ads or "normal"
	assert(ads=="none" or ads=="normal" or ads=="dense","Unknown ad density")
	local adSeed=options.adSeed or Catalog.Seed(tostring(seed).."/ads")
	assert(finite(adSeed),"Invalid ad seed")
	local ar=Random.new(adSeed)
	local function posters(x0,x1,y0,y1,z,dense)
		if ads=="none" or x1-x0<2 then return end
		local busy=ads=="dense" or dense
		local n,rows=busy and 3 or 2,busy and 2 or 1
		for tier=1,rows do for i=1,n do
			local pw=math.min(2.7,(x1-x0)/n-.3);local ph=math.min(2.3,(y1-y0)/rows-.2)
			local a=POSTERS[ar:NextInteger(1,#POSTERS)]
			local row=sign("JapaneseWindowAd",x0+(i-.5)*(x1-x0)/n,y0+(tier-.5)*(y1-y0)/rows,z,pw,ph,a[1],a[2])
			row.ad=true
			-- Stylised product/offer block, entirely fictional and asset-free.
			p("AdOfferStrip",row.cframe.X,row.cframe.Y-ph*.37,z-.06,pw*.85,.28,.05,WHITE,M.SmoothPlastic,"sign")
		end end
	end
	local plinth=options.plinthDrop or 4.5
	assert(finite(plinth) and plinth>=0 and plinth<=12,"Invalid plinth drop")
	if plinth>0 then p("BuriedPlinth",0,-plinth/2,0,w,plinth,.8,pal.wall,M.Concrete,"plinth") end
	local entry=role=="entrance"
	local brand=spec.signless and "" or (options.brand or spec.brand)
	if role~="entrance" then brand="" end
	local head=h-2.5
	if role=="blind" and f~="plainWall" and f~="panelWall" and f~="utilityWall" then
		wall("QuietBlindFront",-w/2,w/2,0,h,0,.8)
	elseif role=="window" and spec.generation~=3 then
		-- Continuation bays are quiet wall/window treatments, never duplicate shop
		-- entries, parking portals, menu boards or produce counters in an alley.
		local a,b=-w/2+1.1,w/2-1.1
		concrete({{a,b,3.2,math.min(h-2.2,8.2)}})
		glass(a,b,3.2,math.min(h-2.2,8.2),.3,spec.family=="residential" or spec.family=="service")
	elseif spec.generation==3 then
		if f=="plainWall" then
			wall("PlainConcreteWall",-w/2,w/2,0,h,0,.8)
		elseif f=="panelWall" then
			wall("PanelConcreteWall",-w/2,w/2,0,h,0,.8)
			for x=-w/2+6,w/2-.5,6 do p("VerticalPanelSeam",x,h/2,-.415,.055,h,.06,pal.trim,M.Concrete) end
			p("HorizontalPanelSeam",0,h*.52,-.415,w,.055,.06,pal.trim,M.Concrete)
		elseif f=="highSlit" then
			local a,b=-w/2+1.5,w/2-1.5;local y=h*.65
			concrete({{a,b,y,y+1.5}});glass(a,b,y,y+1.5,.24,true)
			p("SlitRainHood",0,y+1.8,-.48,w-2.4,.15,.8,pal.trim,M.Metal)
		elseif f=="pairedFrost" then
			local ww=math.min(5.2,w*.24);local y=3.5;local top=math.min(8,h-2.2)
			concrete({{-w*.24-ww/2,-w*.24+ww/2,y,top},{w*.24-ww/2,w*.24+ww/2,y,top}})
			for _,x in {-w*.24,w*.24} do glass(x-ww/2,x+ww/2,y,top,.28,true);p("WindowConcreteSill",x,y-.15,-.25,ww+.4,.3,.75,pal.wall,M.Concrete) end
		elseif f=="utilityWall" then
			wall("UtilityConcreteWall",-w/2,w/2,0,h,0,.85)
			p("UtilityVentFrame",w*.2,4.7,-.5,3.4,2.5,.25,pal.trim,M.Metal)
			for y=3.65,5.75,.25 do p("UtilityVentSlat",w*.2,y,-.68,3.0,.1,.2,WHITE,M.Metal) end
			p("VerticalDrainPipe",-w*.32,h/2,-.6,.2,h,.2,WHITE,M.Metal)
			for y=1,h-1,3.5 do p("DrainPipeClamp",-w*.32,y,-.6,.42,.15,.32,pal.trim,M.Metal) end
		elseif f=="rearDoor" then
			local dx=-w*.2;local dw=4.4;local dh=8.1
			local holes={{w*.18,w*.18+3,6.4,8.1}}
			if entry then table.insert(holes,{dx-dw/2,dx+dw/2,0,dh}) end
			concrete(holes);glass(w*.18,w*.18+3,6.4,8.1,.25,true)
			if entry then door(dx,dw,0,dh,.45,true) end
		elseif f=="tiledWall" then
			local a,b=-w*.28,w*.12;local y,top=4.6,math.min(8.2,h-2)
			concrete({{a,b,y,top}},M.Brick);glass(a,b,y,top,.27,true)
			p("LowTiledLedge",0,1,-.25,w,2,1.15,pal.wall,M.Brick,"wall")
			p("BoundaryCoping",0,2.08,-.25,w,.16,1.35,pal.trim,M.Concrete)
		else
			-- Eight new public frontages share framing, but use distinct opaque
			-- opening proportions and fixtures. Window role removes every portal.
			local dx,dw=w*.27,4.8;local dh=8.2
			local sill=f=="clinic" and 2.5 or f=="soba" and 3.2 or f=="timberHouse" and 3.5 or .7
			if f=="laundry" then dx=-w*.27;dw=5.2 end
			if f=="bathhouse" then dx=0;dw=7.2 end
			local wx0,wx1=-w/2+1,w/2-1
			local holes={}
			if entry then table.insert(holes,{dx-dw/2,dx+dw/2,0,dh}) end
			local windows={}
			if entry then
				if dx-dw/2-.4-wx0>.7 then table.insert(windows,{wx0,dx-dw/2-.4}) end
				if wx1-dx-dw/2-.4>.7 then table.insert(windows,{dx+dw/2+.4,wx1}) end
			else table.insert(windows,{wx0,wx1}) end
			for _,q in windows do table.insert(holes,{q[1],q[2],sill,head}) end
			concrete(holes,(f=="bathhouse" or f=="bookshop") and M.Brick or M.Concrete)
			for _,q in windows do glass(q[1],q[2],sill,head,.3,f=="clinic" or f=="timberHouse" or f=="bathhouse") end
			if entry then door(dx,dw,0,dh,1.2,f=="timberHouse" or f=="bathhouse") end
			if f=="laundry" then
				for _,q in windows do p("LaundryTransomBand",(q[1]+q[2])/2,head-1.25,-.1,q[2]-q[1],.2,.5,pal.trim,M.Metal) end
				if entry then for _,x in {w*.04,w*.26} do
					p("LaundryMachineDisplay",x,2.1,1.6,3.8,4.2,1.8,WHITE,M.Metal,"prop")
					p("RoundWasherWindow",x,2.3,.63,.14,2.5,2.5,pal.trim,M.Metal,"prop",0,CFrame.Angles(0,math.pi/2,0),Enum.PartType.Cylinder)
				end end
			elseif f=="bicycle" then
				local a,b=wx0,dx-dw/2-.4
				p("WorkshopHalfShutter",(a+b)/2,head-1.4,-.05,b-a,2.8,.3,pal.trim,M.Metal,"wall")
				for y=head-2.7,head-.1,.3 do p("WorkshopShutterRib",(a+b)/2,y,-.24,b-a,.07,.09,WHITE,M.Metal) end
				if entry then p("RepairWorkbench",-w*.18,1.6,1.4,w*.36,3.2,1.6,WOOD,M.Wood,"prop") end
			elseif f=="florist" then
				canopy(0,w-.8,head,2.7,Color3.fromRGB(68,106,77))
				for _,x in {-w/2+1,w/2-1} do p("FloristTimberPost",x,head/2,-.2,.4,head,.8,WOOD,M.Wood) end
				if entry then planter(-w*.30,-1.2,3.2);p("FlowerDisplayShelf",-w*.16,2.4,1.6,w*.3,.25,2,WOOD,M.Wood,"prop") end
			elseif f=="clinic" then
				p("ClinicPrivacySpandrel",0,3.3,-.03,w-2,1.4,.4,WHITE,M.SmoothPlastic,"wall")
				-- Split around the door, rather than an opaque bar across its portal.
				out.parts[#out.parts]=nil
				for _,q in windows do p("ClinicPrivacySpandrel",(q[1]+q[2])/2,3.3,-.03,q[2]-q[1],1.4,.4,WHITE,M.SmoothPlastic,"wall") end
				if entry then canopy(dx,dw+1.4,dh+.35,1.8,WHITE) end
			elseif f=="bookshop" then
				for _,q in windows do
					p("DeepBookDisplaySill",(q[1]+q[2])/2,sill+.15,1.0,q[2]-q[1],.3,2,WOOD,M.Wood)
					if entry then for y=2,6.5,1.5 do p("BookDisplayShelf",(q[1]+q[2])/2,y,1.4,q[2]-q[1]-.3,.14,.7,WOOD,M.Wood,"prop") end end
				end
				for _,x in {-w/2+.65,w/2-.65} do p("BookshopPilaster",x,head/2,-.4,.4,head,1.1,pal.wall,M.Brick,"wall") end
			elseif f=="soba" then
				for _,q in windows do for x=q[1]+.2,q[2]-.2,.65 do p("SobaWindowLattice",x,(head+sill)/2,-.02,.12,head-sill,.3,WOOD,M.Wood) end end
				canopy(0,w-1,head,2.1,WOOD)
				if entry then for i=1,4 do p("SobaNoren",dx-dw/2+(i-.5)*dw/4,dh-.75,.4,dw/4-.08,1.5,.12,Color3.fromRGB(58,72,84),M.Fabric) end end
			elseif f=="bathhouse" then
				for _,x in {-w/2+1,w/2-1} do p("TiledEntryPier",x,head/2,-.1,.8,head,1.1,Color3.fromRGB(174,194,195),M.Brick,"wall") end
				if entry then for i=1,2 do p("BathhouseSplitCurtain",dx-dw/2+(i-.5)*dw/2,dh-.8,.4,dw/2-.12,1.6,.12,i==1 and Color3.fromRGB(55,78,125) or Color3.fromRGB(152,63,65),M.Fabric) end end
				canopy(0,w-1,head,2.8,pal.trim)
			elseif f=="timberHouse" then
				for _,q in windows do for x=q[1]+.3,q[2]-.3,.55 do p("HouseTimberScreen",x,(head+sill)/2,-.4,.15,head-sill,.9,WOOD,M.Wood) end end
				if entry then canopy(dx,dw+.9,dh+.3,2.5,WOOD) end
			end
		end
	elseif f=="garage" or f=="twinGarage" or f=="pilotis" or f=="loading" then
		local side=1.0;local top=h-2.0
		pier(-w/2+side/2,side);pier(w/2-side/2,side)
		wall("ParkingHeader",-w/2+side,w/2-side,top,h,0,1.5)
		if f=="twinGarage" then
			pier(0,1.2)
			portal(-w/4+.2,w/2-1.6,0,top,8,"parking");portal(w/4-.2,w/2-1.6,0,top,8,"parking")
		elseif f=="pilotis" then
			for _,x in {-w*.23,w*.23} do p("RoundPilotis",x,top/2,1.2,top,1.0,1.0,pal.wall,M.Concrete,"wall",0,CFrame.Angles(0,0,math.pi/2),Enum.PartType.Cylinder) end
			portal(0,w*.46-1.1,0,top,9,"parking")
		elseif f=="loading" then
			local split=w/2-8
			wall("ServiceSidePanel",split,w/2-1,0,top,0,.9)
			-- Independent service door in the panel; replace its covered region with holes.
			out.parts[#out.parts]=nil
			wall("ServiceSidePier",split,split+.7,0,top,0,.9)
			wall("ServiceDoorHead",split+.7,w/2-1,8.2,top,0,.9)
			door((split+.7+w/2-1)/2,w/2-1-split-.7,0,8.2,.8,true)
			portal((-w/2+1+split)/2,split+w/2-1,0,top,8,"loading")
		else portal(0,w-2,0,top,8,"parking") end
		p("GarageCeilingStrip",0,top-.2,2.8,w-3,.1,.32,WHITE,M.Neon,"light")
		for _,x in {-w/2+.65,w/2-.65} do p("PierProtection",x,2.8,-.51,.28,5.6,.12,pal.trim,M.Metal) end
	elseif f=="sparse" or f=="servicePair" then
		local dw=4.8;local dx=-w*.27;local dh=math.min(8.4,h-2)
		local holes={};if entry then table.insert(holes,{dx-dw/2,dx+dw/2,0,dh}) end
		if f=="servicePair" and entry then table.insert(holes,{w*.22-dw/2,w*.22+dw/2,0,dh}) end
		local wx0,wx1=f=="servicePair" and -2 or 0,f=="servicePair" and 2 or w/2-2
		table.insert(holes,{wx0,wx1,5.4,7.6});concrete(holes)
		glass(wx0,wx1,5.4,7.6,.3,true)
		if entry then door(dx,dw,0,dh,.6,true);if f=="servicePair" then door(w*.22,dw,0,dh,.6,true) end end
		p("WallVent",w/2-2.4,2.8,-.45,2.2,1.3,.15,pal.trim,M.Metal)
		for y=2.3,3.3,.2 do p("VentLouver",w/2-2.4,y,-.56,2,.06,.12,WHITE,M.Metal) end
		for _,x in {-w/2+1,w/2-1} do p("DrainPipe",x,h/2,-.55,.12,h,.16,WHITE,M.Metal) end
	elseif f=="brickHome" or f=="townhouse" or f=="gateHome" or f=="raised" then
		local dx,dw=w*.27,4.8;local y0=f=="raised" and 2.8 or 0
		local dh=math.min(8.5,h-y0-1.2)
		local wx0,wx1=-w/2+1,dx-dw/2-1.0
		local holes={};if entry then table.insert(holes,{dx-dw/2,dx+dw/2,y0,y0+dh}) end
		if f~="townhouse" then table.insert(holes,{wx0,wx1,2.2,math.min(8.6,h-2.0)}) end
		concrete(holes,(f=="brickHome" or f=="gateHome") and M.Brick or M.Concrete)
		if f=="raised" then
			-- Street-level shutter with stairs beside it, not an opening across the slab.
			p("GarageShutter",(wx0+wx1)/2,4.2,-.45,wx1-wx0,8.4,.24,WHITE,M.Metal,"wall")
			for y=.3,8.2,.4 do p("GarageShutterRib",(wx0+wx1)/2,y,-.6,wx1-wx0,.06,.06,pal.trim,M.Metal) end
			if entry then
				for i=1,7 do local rise=y0*i/7;p("RaisedEntryTread",dx,rise/2,-4.8+(i-.5)*.7,dw,rise,.7,pal.wall,M.Concrete,"threshold") end
				for _,x in {dx-dw/2-.12,dx+dw/2+.12} do p("StairRail",x,3.2,-2.2,.12,.12,5.1,pal.trim,M.Metal) end
			end
		elseif f~="townhouse" then glass(wx0,wx1,2.2,math.min(8.6,h-2),.3,true) end
		if entry then
			door(dx,dw,y0,dh,f=="townhouse" and 2.5 or 1.6,f=="townhouse")
			p("EntryIntercom",dx-dw/2-.5,y0+4.4,-.48,.5,1.0,.2,pal.trim,M.Metal,"prop")
		end
		if f=="townhouse" then
			for _,x in {dx-dw/2-.8,dx+dw/2+.8} do p("RoundEntryColumn",x,head/2,-1,head,.65,.65,Color3.fromRGB(162,150,126),M.Metal,"wall",0,CFrame.Angles(0,0,math.pi/2),Enum.PartType.Cylinder) end
			for x=-w/2+.7,dx-dw/2-2,.55 do p("PrivacyFin",x,h/2,-.65,.13,h,.8,WOOD,M.Wood) end
			canopy(dx,dw+2.5,head,3.5);planter(-w*.25,-1.6,3.8)
		elseif f=="gateHome" then
			wall("LowBoundaryWall",-w/2,dx-dw/2-.5,0,2.0,-2,1,M.Brick)
			for x=wx0+.4,dx-dw/2-.5,.6 do p("BoundaryRailing",x,3,-2,.08,2,.1,pal.trim,M.Metal) end
			if entry then for i=1,6 do p("ApproachGateBar",dx-dw/2+(i-.5)*dw/6,1.5,-2,.1,3,.15,pal.trim,M.Metal,"door") end end
			planter(-w/2+2,-3.1,3)
		elseif f=="brickHome" then
			planter(-w/2+3,-1.5,4.2);canopy(dx,dw+1,head,2)
			sign("SmallResidenceName",-w*.15,h-1.1,-.44,w*.42,.7,brand,pal.wall,pal.trim);brand=""
		end
	elseif f=="stackedGlass" or f=="tallGlass" then
		local dw,dx=7.2,w*.27;local dh=9.4
		pier(-w/2+.6,1.2);pier(w/2-.6,1.2)
		wall("TopCap",-w/2+1.2,w/2-1.2,h-.8,h,0,.9)
		local left,right=entry and dx-dw/2 or w/2-1.2+.25,entry and dx+dw/2 or w/2
		if f=="stackedGlass" then
			local seam=12.5
			-- Existing 4.5-stud slab lies behind this opaque spandrel; it is not removed.
			wall("StoreySpandrel",-w/2+1.2,w/2-1.2,seam,seam+4.5,0,.8)
			for x=-w/2+1.5,w/2-1.5,.45 do p("SpandrelRib",x,seam+2.25,-.5,.12,4.5,.25,Color3.fromRGB(164,147,112),M.Metal) end
			glass(-w/2+1.2,left-.25,.4,seam,.3);if entry then glass(right+.25,w/2-1.2,.4,seam,.3) end
			glass(-w/2+1.2,w/2-1.2,seam+4.5,h-.8,.3)
			if entry then glass(dx-dw/2,dx+dw/2,dh,seam,2);canopy(dx,dw+2,10.2,3.3) end
		else
			-- True void is required; never automatically erase an existing first-floor slab.
			glass(-w/2+1.2,left-.25,.4,h-.8,.3);if entry then glass(right+.25,w/2-1.2,.4,h-.8,.3) end
			for x=-w/2+2,w/2-2,6 do for y=6,h-1,6 do p("PointGlassFixing",x,y,-.01,.23,.23,.14,WHITE,M.Metal) end end
			if entry then
				glass(dx-dw/2,dx+dw/2,dh+1,h-.8,.3)
				p("VestibuleRoof",dx,dh+.8,1.4,dw+1,.4,3.5,pal.trim,M.Metal)
			end
		end
		if entry then door(dx,dw,0,dh,2,false) end
	else
		-- Retail families: different proportions, pier patterns and opening functions.
		local dx,dw=w*.25,5.0
		if f=="posterShop" then dx=0;dw=7.2 end
		if f=="localShop" then dx=w*.25;dw=4.5 end
		if f=="salon" then dx=-w*.24;dw=4.8 end
		if f=="fastFood" then dx=0;dw=6.4 end
		if f=="kingBurger" then dx=w*.28;dw=5.2 end
		if f=="coffeeChain" then dx=-w*.27;dw=4.8 end
		local dh=math.min(8.8,head-.25)
		pier(-w/2+.45,.9);pier(w/2-.45,.9)
		wall("ShopFascia",-w/2+.9,w/2-.9,head,h,0,.8,f=="localShop" and M.Brick or M.Concrete)
		local x0,x1=-w/2+.9,w/2-.9
		if f=="produce" then
			portal(0,w*.38-.4,0,head,5,"openShop")
			canopy(0,w-.8,head,3.5,Color3.fromRGB(76,112,65))
			for _,x in {-w*.30,w*.30} do
				p("ProduceCounter",x,1.25,1.5,w*.22,2.5,2.3,WOOD,M.Wood,"prop")
				for i=1,3 do p("ProduceCrate",x+(i-2)*1.6,2.9,1.5,1.45,.7,1.5,Color3.fromRGB(95,128,67),M.SmoothPlastic,"prop") end
			end
		elseif f=="hatch" then
			local hx0,hx1=-w/2+2,1
			local holes={{hx0,hx1,3.5,7.0}};if entry then table.insert(holes,{dx-dw/2,dx+dw/2,0,dh}) end
			-- Replace generic header/piers with a decomposed opaque wall.
			for i=#out.parts,1,-1 do if out.parts[i].name=="ConcretePier" or out.parts[i].name=="ShopFascia" then table.remove(out.parts,i) end end
			concrete(holes);glass(hx0,hx1,5.2,7,.3)
			p("ServingLedge",(hx0+hx1)/2,3.5,-.9,hx1-hx0,.3,2,WOOD,M.Wood)
			p("HatchCanopy",(hx0+hx1)/2,7.4,-1,hx1-hx0+1,.3,2.3,pal.trim,M.Metal)
			if entry then door(dx,dw,0,dh,1,true) end
			posters(hx0,hx1,7.5,9.8,-.5)
		elseif f=="grille" then
			local center=1.7;pier(0,center)
			for _,side in {-1,1} do
				local a,b=side==-1 and x0 or center/2,side==-1 and -center/2 or x1
				glass(a,b,.6,head,.4)
				for x=a+.2,b-.2,.7 do p("SecurityGrilleBar",x,head/2,-.12,.07,head,.12,pal.trim,M.Metal,"wall") end
				for y=.8,head,1.6 do p("SecurityGrilleRail",(a+b)/2,y,-.15,b-a,.06,.1,pal.trim,M.Metal) end
				posters(a+.3,b-.3,2.8,5.3,.17,true)
			end
			canopy(0,w-1,head,2.7,pal.trim)
			-- This is explicitly a closed restaurant variant, no traversable entry claimed.
			out.closed=true
		else
			local function shopWindow(a,b)
				local sill=f=="electronics" and 2.4 or f=="salon" and .5 or 1.1
				wall("ShopKickplate",a,b,0,sill,0,.7,f=="localShop" and M.Brick or M.Concrete)
				glass(a,b,sill,head,.3,f=="salon")
				if f~="salon" then posters(a+.2,b-.2,3.8,6.2,.15,f=="posterShop") end
				if f=="electronics" then
					p("BoxedDisplayShelf",(a+b)/2,2.6,1.0,b-a-.2,.2,1.3,pal.trim,M.Metal,"prop")
					for x=a+1,b-.6,2 do p("DisplayAppliance",x,3.6,1.1,1.1,1.8,.8,WHITE,M.Metal,"prop") end
				end
			end
			if entry then
				shopWindow(x0,dx-dw/2-.25);shopWindow(dx+dw/2+.25,x1)
				door(dx,dw,0,dh,f=="salon" and 2.4 or 1.0,false)
				glass(dx-dw/2,dx+dw/2,dh,head,1.0)
				for _,x in {dx-dw/2-.125,dx+dw/2+.125} do p("ShopDoorWindowJoint",x,head/2,.15,.30,head,.45,pal.trim,M.Metal) end
			else shopWindow(x0,x1) end
			if f=="fastFood" then
				canopy(0,w-1,head,.95,accent)
				p("YellowCanopyLip",0,head-.22,-.98,w-1,.14,.14,Color3.fromRGB(228,184,51),M.Metal)
				for _,x in {-w/2+1.5,w/2-1.5} do p("RedRestaurantBlade",x,head/2,-.38,.7,head,.2,accent,M.Metal) end
				for _,x in {-dw/2-.55,dw/2+.55} do p("EntranceBeacon",x,head-.7,-.4,.3,.85,.2,Color3.fromRGB(229,190,61),M.Neon,"light") end
			elseif f=="kingBurger" then
				for y=head+.2,h-.1,.36 do p("SmashTimberFascia",0,y,-.5,w-1.8,.28,.15,WOOD,M.Wood) end
				p("SmashRedLintel",0,head-.15,-.46,w-1.8,.25,.35,accent,M.Metal)
				for _,x in {-w/2+1.2,w/2-1.2} do p("SmashBrickButtress",x,head/2,-.08,.45,head,.8,pal.wall,M.Brick,"wall") end
			elseif f=="coffeeChain" then
				canopy(0,w-1,head,2.1,accent)
				for x=w*.24,w/2-1.4,.7 do p("CoffeeTimberFin",x,head/2,-.3,.2,head,1.0,WOOD,M.Wood) end
				p("CoffeeWindowLedge",w*.01,2,-.75,w*.35,.18,1.3,WOOD,M.Wood)
				planter(w/2-2,-1.4,2.1)
			elseif f=="burger" then
				for y=head+.2,h-.1,.35 do p("WoodFasciaCourse",0,y,-.48,w-1.8,.28,.14,WOOD,M.Wood) end
				p("RestaurantRedBand",0,head-.15,-.5,w-1.8,.28,.24,accent,M.Metal)
			elseif f=="posterShop" then
				for i,c in {Color3.fromRGB(47,143,71),WHITE,Color3.fromRGB(44,110,177)} do p("ConvenienceStripe",0,head+.2+(i-1)*.18,-.5,w-1.8,.13,.1,c,M.SmoothPlastic,"sign") end
				p("AutomaticDoorSensor",dx,dh-.1,.7,1.3,.24,.22,pal.trim,M.Metal)
			elseif f=="localShop" then
				canopy(0,w-1,head,1.8,WOOD)
				if entry then for i=1,3 do p("SmallShopNoren",dx-dw/2+(i-.5)*dw/3,dh-.8,.6,dw/3-.08,1.5,.12,accent,M.Fabric) end end
			elseif f=="salon" then canopy(dx,dw+1,dh+.3,2.3,WHITE)
			elseif f=="electronics" then p("DisplayBoxHead",-w*.18,head-.2,-.2,w*.55,.35,.8,pal.trim,M.Metal) end
		end
	end
	if brand~="" and role=="entrance" then
		local small=spec.family=="residential" or spec.family=="service" or spec.family=="office"
		sign("IdentityPanel",0,h-(small and .9 or 1.15),-.62,w-2.3,small and .75 or 1.4,brand,small and pal.wall or accent,small and pal.trim or WHITE)
	end
	if entry and out.door then sign("AddressPlaque",-w/2+.65,1.6,-.54,.65,.8,tostring(rng:NextInteger(1,99)),pal.trim) end
	-- Shallow interior context belongs to the review gallery only.
	if options.vignette then
		local depth=(spec.family=="parking" or f=="loading") and 9 or 7
		p("PreviewFloor",0,-.12,depth/2,w-.2,.24,depth,Color3.fromRGB(135,130,119),M.Concrete,"preview")
		p("PreviewRearWall",0,h/2,depth,w-.2,h,.24,Color3.fromRGB(86,83,75),M.SmoothPlastic,"preview")
		for _,x in {-w/2+.12,w/2-.12} do p("PreviewSideWall",x,h/2,depth/2,.24,h,depth,Color3.fromRGB(116,111,100),M.Concrete,"preview") end
		p("PreviewCeiling",0,h-.2,depth/2,w-.2,.2,depth,pal.wall,M.SmoothPlastic,"preview")
		p("PreviewCeilingLight",0,h-2.4,depth*.7,w*.55,.10,.25,WHITE,M.Neon,"light")
		if spec.family=="parking" then
			for _,x in {-w*.28,0,w*.28} do p("PreviewParkingLine",x,.035,depth/2,.12,.06,depth-1,WHITE,M.SmoothPlastic,"preview") end
		elseif f=="burger" or f=="posterShop" or f=="localShop" then
			p("PreviewShopCounter",-w*.20,1.4,5,w*.35,2.8,1.3,WOOD,M.Wood,"preview")
		end
	end
	out.adSeed=adSeed;out.variant=rng:NextInteger(1,3)
	if options.mirror then
		local function flip(v) return Vector3.new(-v.X,v.Y,v.Z) end
		for _,r in out.parts do local cf=r.cframe;r.cframe=CFrame.fromMatrix(flip(cf.Position),-flip(cf.XVector),flip(cf.YVector));if r.supportLocalBottom then r.supportLocalBottom=flip(r.supportLocalBottom) end end
		for _,q in out.portals do q.x=-q.x end
		if out.door then out.door.x=-out.door.x end
	end
	return out
end
return E
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">GroundFacadeKit</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Standalone facade drafts. Requiring this module does not build anything.
-- Pivot: centre of bay, slab TOP at Y=0, exterior faces local -Z.
-- Layout returns reusable data; Build materialises it for edit previews or a future client renderer.
local Catalog = require(script.Parent.GroundFacadeCatalog)
local Expansion = require(script.Parent.GroundFacadeExpansion)
local GlassVisual = require(script.Parent.GlassVisual)
local HttpService = game:GetService("HttpService")
local Kit = {}
local GLASS = Color3.fromRGB(105,132,137)
local WOOD = Color3.fromRGB(111,80,51)
local WHITE = Color3.fromRGB(239,234,220)
local M = Enum.Material

local function finite(v) return type(v)=="number" and v==v and math.abs(v)<1e12 end

function Kit.Layout(id, options)
	options=options or {}
	local spec=Catalog.Get(id)
	if options.allowEntrance==false and (options.role==nil or options.role=="entrance") then options=table.clone(options);options.role="window" end
	if spec.generation and spec.generation>=2 then return Expansion.Layout(spec,options) end
	if options.role=="window" or options.role=="blind" then
		local quiet=table.clone(Catalog.Get(options.role=="blind" and "40_PanelSeams" or "41_HighSlit"))
		quiet.id=id;quiet.width=spec.width;quiet.minWidth=spec.minWidth;quiet.maxWidth=spec.maxWidth;quiet.palette=spec.palette
		return Expansion.Layout(quiet,options)
	end
	local w,h=options.width or spec.width,options.height or 12.5
	assert(finite(w) and w>=spec.minWidth and w<=spec.maxWidth,"Width outside this type's fit range")
	assert(finite(h) and h>=10.5 and h<=24,"Ground facade clear height must be 10.5..24 studs")
	local role=options.role or "entrance"
	assert(role=="entrance" or role=="window" or role=="blind","Unknown facade role")
	local seed=options.seed or Catalog.Seed(id)
	assert(finite(seed),"Invalid seed")
	local rng=Random.new(seed)
	local pal=assert(Catalog.PALETTES[options.palette or spec.palette],"Unknown facade palette")
	local accent=options.accent or spec.accent or pal.accent
	local out={id=id,width=w,height=h,seed=seed,role=role,parts={}}
	local function p(name,x,y,z,sx,sy,sz,color,material,kind,transparency,rotation)
		assert(sx>=0.05 and sy>=0.05 and sz>=0.05,"Undersize facade part: "..name)
		local cf=CFrame.new(x,y,z)*(rotation or CFrame.identity)
		local row={name=name,cframe=cf,size=Vector3.new(sx,sy,sz),color=color,material=material or M.SmoothPlastic,
			kind=kind or "trim",transparency=transparency or 0}
		table.insert(out.parts,row)
		return row
	end
	local function text(row,value,ink,face)
		row.text=value; row.ink=ink or WHITE; row.face=face or Enum.NormalId.Front
		return row
	end
	local function sign(name,x,y,z,sx,sy,value,bg,ink,face)
		return text(p(name,x,y,z,sx,sy,0.24,bg or accent,M.SmoothPlastic,"sign"),value,ink,face)
	end
	local function planter(x,z,wide)
		wide=wide or 2.8
		local group="planter/"..tostring(#out.parts+1)
		local box=p("Planter",x,0.85,z,wide,1.7,2.3,pal.trim,M.Concrete,"prop")
		box.supportGroup=group;box.supportBase=true;box.supportLocalBottom=Vector3.new(x,0,z)
		local plant=p("ClippedGreenery",x,2.1,z,wide-0.3,1.4,2,Color3.fromRGB(65,87,62),M.Grass,"prop")
		plant.supportGroup=group
	end
	local function canopy(depth,color)
		p("Canopy",0,h-2.8,-depth/2,w-0.8,0.45,depth,color or pal.trim,M.Metal)
		p("CanopyWarmStrip",0,h-3.08,-depth+0.5,w-2,0.12,0.22,Color3.fromRGB(237,207,155),M.Neon,"light")
	end
	local function blade(value)
		local x=w/2-1.1
		p("BladeBracket",x,h-3.0,-1.4,0.18,0.18,2.5,pal.trim,M.Metal)
		local row=p("BladeSign",x,h-4.7,-2.1,0.3,3.6,2.4,accent,M.SmoothPlastic,"sign")
		text(row,value,WHITE,Enum.NormalId.Right);row.twoSided=true
	end
	local feature=spec.feature
	local pier=(feature=="stoneLobby" or feature=="hotel") and 1.4 or 0.65
	local opening=w-2*pier
	local head=h-2.7
	local recess=spec.depth
	local sill=(feature=="glassLobby" or feature=="showroom") and 0.35 or 1.2
	if feature=="noren" or feature=="lattice" then sill=2 end
	local entry=role=="entrance" and spec.door~="none"
	local doorW=spec.door=="single" and 4.8 or 7.2
	if feature=="directory" then doorW=6 end
	local doorH=math.min(9.4,head-0.4)
	local doorX=(feature=="awning" or feature=="bakery" or feature=="mail") and -w*0.20 or 0
	if feature=="noren" or feature=="lattice" then doorX=w*0.17 end
	local doorZ=recess
	-- Piers meet at the stitch boundary, never extend beyond it.
	for _,x in {-w/2+pier/2,w/2-pier/2} do
		p("EndPier",x,h/2,0,pier,h,0.85,pal.wall,feature=="bakery" and M.Brick or M.Concrete,"wall")
	end
	p("HeadBand",0,h-1.35,0,opening,2.7,0.8,pal.wall,M.Concrete,"wall")
	-- The buried plinth hides the existing slab edge; it does not change or carve the floor.
	local plinth=options.plinthDrop or 4.5
	assert(finite(plinth) and plinth>=0 and plinth<=12,"Invalid plinth drop")
	if plinth>0 then p("BuriedPlinth",0,-plinth/2,0,w,plinth,0.8,pal.wall,M.Concrete,"plinth") end
	local function window(x0,x1)
		local span=x1-x0
		if span<0.8 then return end
		local count=math.max(1,math.ceil(span/7))
		local pw=span/count
		p("Kickplate",(x0+x1)/2,sill/2,0,span,sill,0.7,pal.wall,feature=="bakery" and M.Brick or M.Concrete,"wall")
		for i=1,count do
			local x=x0+(i-0.5)*pw
			p("ShopGlazing",x,(head+sill)/2,0.35,pw-0.14,head-sill,0.18,GLASS,M.Glass,"glass",0.36)
			if i<count then p("Mullion",x0+i*pw,(head+sill)/2,0.17,0.20,head-sill,0.26,pal.trim,M.Metal) end
		end
		for _,x in {x0,x1} do p("WindowEndStile",x,(head+sill)/2,0.17,.20,head-sill,.26,pal.trim,M.Metal) end
		p("SillTrim",(x0+x1)/2,sill,0.08,span,0.16,0.38,pal.trim,M.Metal)
		p("WindowHead",(x0+x1)/2,head,0.08,span,0.18,0.38,pal.trim,M.Metal)
	end
	if feature=="shutter" or role=="blind" then
		p("ShutterSheet",0,head/2,0.1,opening,head,0.35,accent,M.Metal,"wall")
		for y=0.5,head,0.55 do p("ShutterRib",0,y,-0.12,opening,0.07,0.08,pal.trim,M.Metal) end
		p("ShutterLock",0,0.7,-0.25,0.5,0.4,0.18,pal.trim,M.Metal)
	elseif entry then
		local left,right=doorX-doorW/2,doorX+doorW/2
		window(-opening/2,left-0.25);window(right+0.25,opening/2)
		-- Three-dimensional reveal: jambs, soffit, inset transom and threshold.
		for _,x in {left-0.125,right+0.125} do p("DoorReveal",x,head/2,recess/2,0.30,head,recess+0.4,pal.trim,M.Metal) end
		p("DoorSoffit",doorX,head,recess/2,doorW+0.48,0.24,recess+0.4,pal.trim,M.Metal)
		p("Threshold",doorX,0.10,recess/2,doorW,0.2,recess+0.5,pal.wall,M.Concrete,"threshold")
		p("DoorTransom",doorX,(head+doorH)/2,doorZ,doorW,head-doorH,0.18,GLASS,M.Glass,"glass",0.32)
		local leaves=spec.door=="single" and 1 or 2
		for i=1,leaves do
			local lw=doorW/leaves
			local x=doorX-doorW/2+(i-0.5)*lw
			p("DoorGlass",x,doorH/2,doorZ,lw-0.16,doorH-0.15,0.18,GLASS,M.Glass,"door",0.32)
			for _,edge in {-1,1} do p("DoorStile",x+edge*(lw/2-0.08),doorH/2,doorZ-0.15,0.16,doorH,0.24,pal.trim,M.Metal) end
			p("DoorBottomRail",x,0.25,doorZ-0.15,lw,0.4,0.26,pal.trim,M.Metal)
			p("DoorTopRail",x,doorH-0.1,doorZ-0.15,lw,0.2,0.26,pal.trim,M.Metal)
			p("DoorHandle",x+(leaves==1 and lw*0.32 or (i==1 and lw*0.32 or -lw*0.32)),4.4,doorZ-0.38,0.12,1.4,0.16,accent,M.Metal)
		end
		out.door={x=doorX,width=doorW,height=doorH,recess=recess,interactive=false}
	else
		window(-opening/2,opening/2)
	end
	local brand=options.brand or spec.brand
	local sub=options.subtitle or spec.subtitle
	if role=="window" and not options.brand then brand="";sub="" end
	if brand~="" then
		local quiet=feature=="display" or feature=="stoneLobby" or feature=="glassLobby" or feature=="mail"
		sign("FasciaSign",0,h-1.1,-0.53,w-2*pier-0.5,1.85,brand,quiet and pal.wall or accent,quiet and pal.trim or WHITE)
	end
	if feature=="stripe" then
		for i,c in {accent,WHITE,Color3.fromRGB(63,82,145)} do p("BrandStripe",0,h-2.3+(i-2)*0.16,-0.5,opening,0.16,0.16,c,M.SmoothPlastic,"sign") end
		if entry then sign("OpeningHours",-w/2+2.6,6,-0.1,3.1,1.8,"24H",accent) end
	elseif feature=="awning" or feature=="bakery" then
		local depth=3
		p("FabricAwning",0,h-3.0,-1.4,opening,0.22,depth,accent,M.Fabric,"trim",0,CFrame.Angles(math.rad(-12),0,0))
		p("AwningValance",0,h-3.5,-2.85,opening,0.55,0.15,accent,M.Fabric)
		if entry then sign("MenuBoard",w/2-3.2,3.7,-0.35,3.4,4.2,feature=="bakery" and "PAN\nBREAD\nTAKE AWAY" or "COFFEE\nTEA\nTAKE AWAY",pal.trim);blade(feature=="bakery" and "PAN" or "喫茶") end
	elseif feature=="noren" then
		if entry then
			for i=1,3 do p("NorenPanel",doorX-doorW/2+(i-0.5)*doorW/3,doorH-0.95,0.5,doorW/3-0.10,1.8,0.12,accent,M.Fabric) end
			local x=-w/2+3.2
			p("TicketMachine",x,2.7,-0.55,2.7,5.4,1.4,WHITE,M.Metal,"prop")
			sign("TicketMenu",x,3.2,-1.32,2.3,2.8,"食券\nRAMEN\n¥ 900",pal.trim)
			p("TicketSlot",x,1.0,-1.32,1.5,0.16,0.12,pal.trim,M.Metal,"prop")
			blade("麺")
		end
	elseif feature=="lattice" then
		local x0,x1=-opening/2,(entry and doorX-doorW/2-0.4 or opening/2)
		for x=x0+0.5,x1-0.2,0.7 do p("TimberSlat",x,head/2,-0.1,0.16,head,0.25,WOOD,M.Wood) end
		canopy(2,WOOD)
		if entry then
			for _,x in {-w/2+2.0,w/2-2.0} do
				p("Lantern",x,7.0,-1.3,1.1,2.0,1.1,Color3.fromRGB(204,88,53),M.Neon,"light")
				p("LanternCap",x,8.05,-1.3,1.15,0.15,1.15,pal.trim,M.Metal)
			end
			blade("酒場")
		end
	elseif feature=="display" or feature=="showroom" then
		p("DisplayLight",0,head-0.3,2.4,w-3,0.12,0.22,WHITE,M.Neon,"light")
		if options.vignette then
			for _,x in {-w*0.30,w*0.30} do
				p("DisplayPlinth",x,0.75,2.5,3,1.5,2.2,pal.wall,M.Concrete,"prop")
				p("DisplayObject",x,2.6,2.5,1.4,2.2,1.2,accent,M.SmoothPlastic,"prop")
			end
		end
	elseif feature=="pharmacy" then
		local x=-w/2+2.8
		p("PharmacyCrossV",x,5.8,-0.2,0.65,2.1,0.22,accent,M.SmoothPlastic,"sign")
		p("PharmacyCrossH",x,5.8,-0.32,2.1,0.65,0.22,accent,M.SmoothPlastic,"sign")
		if entry then blade("薬") end
	elseif feature=="directory" then
		if entry then
			sign("TenantDirectory",-w/2+2.6,4.7,-0.18,3.2,6,"4F  OFFICE\n────────\n3F  STUDIO\n────────\n2F  CAFE\n────────\n1F  ENTRY",pal.trim)
			blade("2F\n3F\n4F")
		end
		canopy(2.0)
	elseif feature=="stoneLobby" or feature=="glassLobby" then
		canopy(feature=="stoneLobby" and 3.5 or 2.5)
		if entry then
			planter(-w/2+2.6,-1.1,3.3);planter(w/2-2.6,-1.1,3.3)
			sign("LobbyDirectory",w/2-5.4,4.5,-0.1,2.8,3.2,"OFFICE\nRECEPTION",pal.trim)
		end
	elseif feature=="hotel" or feature=="timberHotel" then
		canopy(feature=="hotel" and 5 or 3.2)
		if feature=="timberHotel" then
			for _,side in {-1,1} do for i=0,4 do p("TimberFin",side*(w/2-1.4-i*0.55),head/2,-0.1,0.18,head,0.7,WOOD,M.Wood) end end
		end
		if entry then
			planter(-w/2+3.5,-1.6,4);planter(w/2-3.5,-1.6,4)
			sign("HotelEntryPlaque",w/2-5.6,5.3,-0.32,2.4,3.8,"HOTEL\n入口",pal.trim,accent)
		end
	elseif feature=="mail" then
		if entry then
			local x=w/2-4
			p("MailBank",x,3.8,0.1,4.5,3.0,0.6,pal.trim,M.Metal,"prop")
			for i=1,3 do p("MailSlot",x,2.9+(i-1)*0.9,-0.25,3.7,0.12,0.12,accent,M.Metal,"prop") end
			p("Intercom",doorX+doorW/2+0.7,4.5,0,0.6,1.3,0.25,pal.trim,M.Metal,"prop")
		end
		canopy(1.8)
	end
	if entry and sub~="" and feature~="directory" then
		sign("DoorDecal",doorX,6.3,doorZ-0.3,doorW-0.6,0.65,sub,pal.trim)
	end
	-- Preview-only shallow interior, never a solid opaque wall across the facade plane.
	if options.vignette then
		p("PreviewInteriorFloor",0,-0.15,3.4,opening,0.3,6.8,Color3.fromRGB(131,126,117),M.Concrete,"preview")
		p("PreviewInteriorBack",0,head/2,6.8,opening,head,0.3,Color3.fromRGB(74,71,64),M.SmoothPlastic,"preview")
		p("PreviewCeiling",0,head,3.4,opening,0.2,6.8,pal.wall,M.SmoothPlastic,"preview")
		p("PreviewCeilingGlow",0,head-0.2,4.2,opening-2,0.12,0.5,Color3.fromRGB(236,214,176),M.Neon,"light")
		if feature=="stripe" then
			for _,x in {-w*0.3,w*0.3} do p("PreviewShelf",x,2.0,5.0,6,4,0.8,pal.wall,M.SmoothPlastic,"preview") end
		elseif feature=="hotel" or feature=="glassLobby" or feature=="stoneLobby" then
			p("PreviewReception",-w*0.24,1.6,4.7,6,3.2,1.8,WOOD,M.Wood,"preview")
		end
	end
	-- Controlled per-bay variation: an accent plaque and optional mirrored door placement.
	out.variant=rng:NextInteger(1,3)
	if entry then sign("AddressPlate",-w/2+1.1,1.9,-0.52,0.75,0.8,tostring(10+out.variant),pal.trim) end
	if options.mirror then
		-- Mirror the whole bay, including its props, not just the door: otherwise
		-- the ramen ticket machine or menu board can end up across the entrance.
		for _,row in out.parts do
			local cf=row.cframe
			local function flip(v) return Vector3.new(-v.X,v.Y,v.Z) end
			row.cframe=CFrame.fromMatrix(flip(cf.Position),-flip(cf.XVector),flip(cf.YVector))
			if row.supportLocalBottom then row.supportLocalBottom=flip(row.supportLocalBottom) end
			if row.face==Enum.NormalId.Right then row.face=Enum.NormalId.Left
			elseif row.face==Enum.NormalId.Left then row.face=Enum.NormalId.Right end
		end
		if out.door then out.door.x=-out.door.x end
	end
	return out
end

local function addText(part,row)
	local gui=Instance.new("SurfaceGui")
	gui.Name="FacadeTypography";gui.Face=row.face;gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud=40;gui.LightInfluence=0.2;gui.AlwaysOnTop=false;gui.MaxDistance=220;gui.Parent=part
	local label=Instance.new("TextLabel")
	label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text=row.text
	label.Font=Enum.Font.SourceSansSemibold;label.TextScaled=true;label.TextColor3=row.ink
	label.TextWrapped=true;label.Parent=gui
	local pad=Instance.new("UIPadding")
	pad.PaddingLeft=UDim.new(0.04,0);pad.PaddingRight=UDim.new(0.04,0);pad.PaddingTop=UDim.new(0.08,0);pad.PaddingBottom=UDim.new(0.08,0);pad.Parent=label
	if row.twoSided then local other=gui:Clone();other.Face=row.face==Enum.NormalId.Right and Enum.NormalId.Left or Enum.NormalId.Right;other.Parent=part end
end

function Kit.Build(parent,id,frame,options)
	if options and options.nameSeed~=nil and options.brand==nil then
		options=table.clone(options)
		options.brand=Catalog.Brand(id,options.key or id.."/"..tostring(options.seed or Catalog.Seed(id)),options.nameSeed)
	end
	local layout=Kit.Layout(id,options)
	frame=frame or CFrame.identity
	local model=Instance.new("Model")
	model.Name="GroundFacade_"..id
	model:SetAttribute("GroundFacadeDraft",true);model:SetAttribute("FacadeType",id)
	model:SetAttribute("FacadeKitVersion",Catalog.VERSION);model:SetAttribute("FacadeSeed",layout.seed)
	model:SetAttribute("FacadeWidth",layout.width);model:SetAttribute("FacadeHeight",layout.height)
	model:SetAttribute("FacadeRole",layout.role);model:SetAttribute("DoorsInteractive",false)
	model:SetAttribute("FacadePalette",options and options.palette or Catalog.Get(id).palette)
	if options and options.nameSeed then model:SetAttribute("FacadeNameSeed",options.nameSeed) end
	local portals={}
	for _,q in layout.portals or (layout.door and {layout.door} or {}) do table.insert(portals,{x=q.x,width=q.width,y=q.y or 0,height=q.height,recess=q.recess,name=q.name or "entry"}) end
	model:SetAttribute("FacadePortals",HttpService:JSONEncode(portals))
	model:SetAttribute("FacadeFloorSpan",layout.floorSpan or 1);model:SetAttribute("FacadeRequiresVoid",layout.requiresVoid or false)
	if layout.adSeed then model:SetAttribute("FacadeAdSeed",layout.adSeed) end
	if layout.closed then model:SetAttribute("FacadeClosed",true) end
	local ok,err=pcall(function()
		for _,row in layout.parts do
			local part=Instance.new("Part")
			part.Name=row.name;part.Size=row.size;part.CFrame=frame*row.cframe
			part.Color=row.color;part.Material=row.material;part.Transparency=row.transparency
			if row.shape then part.Shape=row.shape end
			part.Reflectance=row.kind=="glass" and 0.06 or 0
			part.Anchored=true;part.CanQuery=true;part.CanTouch=false
			-- Draft doors are a traversable visual portal; windows/walls remain solid.
			part.CanCollide=row.kind=="wall" or row.kind=="glass" or row.kind=="plinth" or row.kind=="threshold"
			part.CastShadow=row.kind~="light" and row.kind~="glass"
			part.TopSurface=Enum.SurfaceType.Smooth;part.BottomSurface=Enum.SurfaceType.Smooth
			part:SetAttribute("FacadePieceKind",row.kind)
			if row.supportGroup then
				part:SetAttribute("FacadeSupportGroup",row.supportGroup)
				part:SetAttribute("FacadeSupportBase",row.supportBase or false)
				if row.supportLocalBottom then
					part:SetAttribute("FacadeSupportLocalX",row.supportLocalBottom.X)
					part:SetAttribute("FacadeSupportLocalBottomY",row.supportLocalBottom.Y)
					part:SetAttribute("FacadeSupportLocalZ",row.supportLocalBottom.Z)
				end
			end
			part:AddTag("NoCSG")
			part.Parent=model
			if row.material==M.Glass then
				GlassVisual.Capture(part,"ground/"..(options and options.key or id.."/"..layout.seed).."/"..tostring(_),part.CanCollide)
			end
			if row.text then addText(part,row) end
		end
		-- A privacy overlay belongs to its physical pane so it disappears with
		-- shattered/removed glass instead of floating across the broken opening.
		for _,film in model:GetChildren() do if film:IsA("BasePart") and film.Name=="PrivacyFilm" then
			local best,dist=nil,math.huge
			for _,pane in model:GetChildren() do if pane:IsA("BasePart") and pane:HasTag("GlassPane") then
				local d=(pane.Position-film.Position).Magnitude;if d<dist then best,dist=pane,d end
			end end
			if best then film.Parent=best;film.CanCollide=false;film.CanQuery=false end
		end end
		-- Window stickers belong to their pane, so paper ads cannot float across
		-- a shattered opening. Fascia signs and wall-mounted boards stay separate.
		for _,overlay in model:GetChildren() do
			if overlay:IsA("BasePart") and (overlay.Name=="JapaneseWindowAd" or overlay.Name=="AdOfferStrip" or overlay.Name=="DoorDecal") then
				local nearest,best=nil,math.huge
				for _,pane in model:GetChildren() do if pane:IsA("BasePart") and pane:HasTag("GlassPane") then
					local q=pane.CFrame:PointToObjectSpace(overlay.Position)
					if math.abs(q.X)<=pane.Size.X/2+.15 and math.abs(q.Y)<=pane.Size.Y/2+.15 and math.abs(q.Z)<.8 and q.Magnitude<best then nearest,best=pane,q.Magnitude end
				end end
				if nearest then overlay:SetAttribute("GlassAttachedOverlay",true);overlay.Parent=nearest;overlay.CanCollide=false;overlay.CanQuery=false end
			end
		end
		model.WorldPivot=frame
		model.Parent=parent
	end)
	if not ok then model:Destroy();error(err) end
	return model,layout
end

-- Exact-length composition, no scaled doorways and no half shop at a corner.
-- Stable key should be SourceSliceId .. piece/run identity, not position or child order.
function Kit.PlanRun(width,key,profile,options)
	options=options or {}
	assert(finite(width) and width>0 and width<=1000,"Invalid facade run width")
	assert(type(key)=="string" and #key>0,"Run needs a stable string key")
	assert(Catalog.PROFILES[profile],"Unknown facade profile")
	local target=options.targetWidth or 28
	assert(finite(target) and target>=14 and target<=60,"Target bay width must be 14..60 studs")
	local n=math.max(1,math.floor(width/target+0.5))
	local bays
	for count=n,1,-1 do
		local bw=width/count
		local rows={}
		for i=1,count do
			local spec=options.facadeType and Catalog.Get(options.facadeType) or Catalog.Pick(profile,key.."/"..i,bw,options.height or 12.5)
			if spec and (bw<spec.minWidth or bw>spec.maxWidth or (options.height or 12.5)<(spec.minHeight or 10.5) or (options.height or 12.5)>(spec.maxHeight or 24)) then spec=nil end
			if not spec then rows=nil;break end
			table.insert(rows,{id=spec.id,width=bw,seed=Catalog.Seed(key.."/"..i),role="entrance"})
		end
		if rows then bays=rows;break end
	end
	-- Too short/awkward to fit a tenant: one simple infill, never a crushed door.
	if not bays then return {{infill=true,width=width,role="blind"}} end
	if profile=="office" or profile=="hotel" or profile=="residential" or profile=="chains" or profile=="twoStorey" or profile=="atrium" then
		local main=options.mainBay or options.portalIndex or (Catalog.Seed(key.."/main")%#bays+1)
		assert(type(main)=="number" and main%1==0 and main>=1 and main<=#bays,"mainBay must select an existing bay")
		for i,b in bays do b.role=i==main and "entrance" or "window" end
		local chosen=bays[main].id
		for _,b in bays do b.id=chosen end
	end
	if profile=="blind" or options.role=="blind" then for _,b in bays do b.role="blind" end
	elseif profile=="window" or options.role=="window" or options.allowEntrance==false then for _,b in bays do b.role="window" end end
	return bays
end

function Kit.BuildRun(parent,width,key,profile,frame,options)
	options=options or {};frame=frame or CFrame.identity
	if profile=="twoStorey" or profile=="atrium" then
		assert(options.height and options.height>=27.5,"Tall frontage needs explicit two-storey clearance")
		if profile=="atrium" then assert(options.confirmedVoid==true,"Atrium facade needs confirmed existing slab-free void") end
	end
	local bays=Kit.PlanRun(width,key,profile,options)
	local holder=Instance.new("Model");holder.Name="GroundFacadeRun_"..profile
	local cursor=-width/2
	local ok,err=pcall(function()
		for index,bay in bays do
			local cf=frame*CFrame.new(cursor+bay.width/2,0,0)
			if bay.infill then
				local h=options.height or 12.5
				assert(finite(h) and h>=10.5 and h<=((profile=="twoStorey" or profile=="atrium") and 36 or 24),"Invalid facade height")
				local p=Instance.new("Part");p.Name="FacadeInfill";p.Size=Vector3.new(width,h,0.8)
				p.CFrame=cf*CFrame.new(0,h/2,0);p.Color=Catalog.PALETTES[options.palette or "stone"].wall;p.Material=M.Concrete
				p.Anchored=true;p.CanTouch=false;p:AddTag("NoCSG");p.Parent=holder
			else
				local opts=table.clone(options);opts.width=bay.width;opts.seed=bay.seed;opts.role=bay.role
				opts.mirror=bay.seed%2==0
				opts.key=key.."/bay"..index
				opts.brand=bay.role=="entrance" and (options.brand or Catalog.Brand(bay.id,key.."/"..index,options.nameSeed)) or ""
				Kit.Build(holder,bay.id,cf,opts)
			end
			cursor+=bay.width
			if index<#bays then
				-- Adjacent bay edges need a physical overlap, especially at rotated frames.
				local seam=Instance.new("Part");seam.Name="FacadeBayJoint";seam.Size=Vector3.new(.18,options.height or 12.5,.8)
				seam.CFrame=frame*CFrame.new(cursor,seam.Size.Y/2,0);seam.Anchored=true;seam.CanTouch=false
				seam.Material=M.Concrete;seam.Color=Catalog.PALETTES[options.palette or "stone"].wall;seam:AddTag("NoCSG");seam.Parent=holder
			end
		end
		holder.WorldPivot=frame;holder:SetAttribute("FacadeRunKey",key);holder:SetAttribute("GroundFacadeDraft",true)
		holder.Parent=parent
	end)
	if not ok then holder:Destroy();error(err) end
	return holder,bays
end
return Kit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">GroundFacadeNames</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Fictional sign identities only. No Instances, geometry, global RNG or networking.
local Names = {}
Names.VERSION = 1

Names.Stems = {
	{id="aoba",japanese="青葉",romanized="AOBA"}, {id="nagi",japanese="なぎ",romanized="NAGI"},
	{id="koma",japanese="こま",romanized="KOMA"}, {id="mori",japanese="森",romanized="MORI"},
	{id="tsuki",japanese="月",romanized="TSUKI"}, {id="sakura",japanese="桜",romanized="SAKURA"},
	{id="asahi",japanese="あさひ",romanized="ASAHI"}, {id="hikari",japanese="ひかり",romanized="HIKARI"},
	{id="sora",japanese="空",romanized="SORA"}, {id="kaede",japanese="楓",romanized="KAEDE"},
	{id="koharu",japanese="こはる",romanized="KOHARU"}, {id="tsumugi",japanese="つむぎ",romanized="TSUMUGI"},
	{id="minato",japanese="みなと",romanized="MINATO"}, {id="yohaku",japanese="余白",romanized="YOHAKU"},
	{id="hinata",japanese="ひなた",romanized="HINATA"}, {id="komorebi",japanese="こもれび",romanized="KOMOREBI"},
	{id="nagisa",japanese="なぎさ",romanized="NAGISA"}, {id="akane",japanese="あかね",romanized="AKANE"},
	{id="sumire",japanese="すみれ",romanized="SUMIRE"}, {id="suzuran",japanese="すずらん",romanized="SUZURAN"},
	{id="wakaba",japanese="若葉",romanized="WAKABA"}, {id="futaba",japanese="ふたば",romanized="FUTABA"},
	{id="shiori",japanese="しおり",romanized="SHIORI"}, {id="kotori",japanese="ことり",romanized="KOTORI"},
	{id="kohaku",japanese="琥珀",romanized="KOHAKU"}, {id="yuzu",japanese="ゆず",romanized="YUZU"},
	{id="azuki",japanese="あずき",romanized="AZUKI"}, {id="sazanami",japanese="さざなみ",romanized="SAZANAMI"},
	{id="tsubaki",japanese="椿",romanized="TSUBAKI"}, {id="natsume",japanese="なつめ",romanized="NATSUME"},
	{id="hibari",japanese="ひばり",romanized="HIBARI"}, {id="harukaze",japanese="春風",romanized="HARUKAZE"},
}

local F={"food"}
local R={"retail"}
local FR={"food","retail"}
local S={"service"}
local SR={"service","retail"}
local O={"office","entry"}
local A={"residential"}
local H={"hotel"}
local P={"parking"}
local function label(id,japanese,romanized,english,categories,format,tag)
	return {id=id,japanese=japanese,romanized=romanized,english=english,
		categories=categories,format=format or "suffix",tag=tag or id}
end
-- Curated nouns + one proper-name stem. Prefix/suffix is specified per noun;
-- arbitrary concatenated Japanese words are never generated.
Names.Labelings = {
	label("ramen","麺処","MENDOKORO","RAMEN",F,"prefix","ramen"),
	label("ramenShop","ラーメン","RAMEN","RAMEN",F,"prefix","ramen"),
	label("soba","そば処","SOBADOKORO","SOBA",F,"prefix","soba"),
	label("udon","うどん屋","UDONYA","UDON",F,"prefix","soba"),
	label("diner","食堂","SHOKUDO","DINER",F),
	label("setMeals","定食屋","TEISHOKUYA","SET MEALS",F,"prefix"),
	label("izakaya","酒場","SAKABA","IZAKAYA",F,"prefix","izakaya"),
	label("smallPlates","小料理","KORYORI","SMALL PLATES",F,"prefix","izakaya"),
	label("yakitori","焼鳥","YAKITORI","YAKITORI",F,"prefix","izakaya"),
	label("sushi","寿司","SUSHI","SUSHI",F,"suffix"),
	label("curry","カレー屋","KAREYA","CURRY",F,"prefix"),
	label("gyoza","餃子屋","GYOZAYA","GYOZA",F,"prefix"),
	label("bento","弁当","BENTO","BENTO",F,"suffix","takeaway"),
	label("deli","惣菜店","SOZAI TEN","DELI",FR,"suffix","takeaway"),
	label("onigiri","おにぎり屋","ONIGIRIYA","ONIGIRI",F,"prefix","takeaway"),
	label("takoyaki","たこ焼き","TAKOYAKI","TAKOYAKI",F,"prefix","takeaway"),
	label("okonomiyaki","お好み焼き","OKONOMIYAKI","OKONOMIYAKI",F,"prefix"),
	label("tempura","天ぷら","TEMPURA","TEMPURA",F,"prefix"),
	label("burger","バーガー","BURGER","BURGERS",F,"suffix","burger"),
	label("kitchen","キッチン","KITCHEN","KITCHEN",F,"prefix","burger"),
	label("kissaten","喫茶","KISSA","COFFEE & TEA",FR,"prefix","coffee"),
	label("coffee","珈琲店","KOHITEN","COFFEE",FR,"suffix","coffee"),
	label("cafe","カフェ","CAFE","CAFE",FR,"prefix","coffee"),
	label("wagashi","和菓子店","WAGASHITEN","JAPANESE SWEETS",FR,"suffix","sweets"),
	label("store","商店","SHOTEN","LOCAL SHOP",R,"suffix","localShop"),
	label("foodStore","食品店","SHOKUHINTEN","GROCERIES",R,"suffix","grocery"),
	label("grocery","食料品店","SHOKURYOHINTEN","FOOD & DAILY GOODS",R,"suffix","grocery"),
	label("greengrocer","青果店","SEIKATEN","FRUIT & VEGETABLES",R,"suffix","produce"),
	label("fruit","果物店","KUDAMONOTEN","FRUIT",R,"suffix","produce"),
	label("fish","鮮魚店","SENGYOTEN","FISH",R,"suffix","grocery"),
	label("butcher","精肉店","SEINIKUTEN","BUTCHER",R,"suffix","grocery"),
	label("rice","米店","KOMETEN","RICE",R,"suffix","grocery"),
	label("tea","茶舗","CHAHO","TEA",R,"suffix","localShop"),
	label("liquor","酒店","SAKETEN","SAKE & DRINKS",R,"suffix","grocery"),
	label("bakery","ベーカリー","BAKERY","BAKERY",FR,"suffix","bakery"),
	label("bread","パン工房","PAN KOBO","BREAD",FR,"prefix","bakery"),
	label("confectionery","菓子店","KASHITEN","SWEETS",FR,"suffix","sweets"),
	label("florist","花店","HANATEN","FLOWERS",R,"suffix","florist"),
	label("flowerStudio","花工房","HANA KOBO","FLOWER STUDIO",R,"prefix","florist"),
	label("bookshop","書店","SHOTEN","BOOKS",R,"suffix","bookshop"),
	label("usedBooks","古書店","KOSHOTEN","USED BOOKS",R,"suffix","bookshop"),
	label("stationery","文具店","BUNGUTEN","STATIONERY",R,"suffix","localShop"),
	label("housewares","雑貨店","ZAKKATEN","DAILY OBJECTS",R,"suffix","boutique"),
	label("clothing","洋服店","YOFUKUTEN","CLOTHING",R,"suffix","boutique"),
	label("shoes","靴店","KUTSUTEN","SHOES",R,"suffix","boutique"),
	label("eyewear","眼鏡店","MEGANETEN","EYEWEAR",R,"suffix","boutique"),
	label("convenience","ストア","STORE","DAILY GOODS",R,"suffix","konbini"),
	label("miniMarket","ミニマート","MINI MART","MINI MARKET",R,"suffix","konbini"),
	label("pharmacy","薬局","YAKKYOKU","PHARMACY",SR,"suffix","pharmacy"),
	label("hairSalon","美容室","BIYOSHITSU","HAIR SALON",SR,"suffix","salon"),
	label("barber","理容室","RIYOSHITSU","BARBER",SR,"suffix","salon"),
	label("laundry","コインランドリー","COIN LAUNDRY","LAUNDRY",S,"prefix","laundry"),
	label("cleaners","クリーニング","CLEANING","CLEANERS",S,"prefix","laundry"),
	label("tailor","洋服直し","YOFUKU NAOSHI","ALTERATIONS",S,"prefix","repair"),
	label("shoeRepair","靴修理","KUTSU SHURI","SHOE REPAIR",S,"prefix","repair"),
	label("watchRepair","時計修理","TOKEI SHURI","WATCH REPAIR",S,"prefix","repair"),
	label("electric","電器店","DENKITEN","ELECTRICAL GOODS",SR,"suffix","electronics"),
	label("repairShop","修理工房","SHURI KOBO","REPAIR WORKSHOP",S,"prefix","electronics"),
	label("bicycles","自転車店","JITENSHATEN","BICYCLES",SR,"suffix","bicycle"),
	label("cycleShop","サイクルショップ","CYCLE SHOP","CYCLE SHOP",SR,"prefix","bicycle"),
	label("photos","写真館","SHASHINKAN","PHOTO STUDIO",S,"suffix"),
	label("printShop","印刷工房","INSATSU KOBO","PRINTING",S,"prefix"),
	label("clinic","クリニック","CLINIC","CLINIC",S,"suffix","clinic"),
	label("dentist","歯科","SHIKA","DENTAL CLINIC",S,"suffix","clinic"),
	label("realEstate","不動産","FUDOSAN","REAL ESTATE",S,"suffix"),
	label("parcel","宅配受付","TAKUHAI UKETSUKE","PARCEL COUNTER",S,"prefix"),
	label("bathhouse","湯","YU","BATHHOUSE",S,"suffix","bathhouse"),
	label("designOffice","デザイン事務所","DESIGN JIMUSHO","DESIGN OFFICE",O,"suffix","showroom"),
	label("studio","スタジオ","STUDIO","STUDIO",O,"suffix","showroom"),
	label("office","オフィス","OFFICE","OFFICE",O,"suffix"),
	label("building","ビル","BUILDING","BUILDING",O,"suffix"),
	label("residence","レジデンス","RESIDENCE","RESIDENCE",A,"suffix"),
	label("heights","ハイツ","HEIGHTS","APARTMENTS",A,"suffix"),
	label("house","ハウス","HOUSE","PRIVATE ENTRY",A,"suffix"),
	label("court","コート","COURT","RESIDENCE",A,"suffix"),
	label("hotel","ホテル","HOTEL","HOTEL",H,"prefix"),
	label("inn","旅館","RYOKAN","INN",H,"suffix"),
	label("parking","駐車場","CHUSHAJO","PARKING",P,"suffix"),
	label("monthlyParking","月極駐車場","TSUKIGIME CHUSHAJO","MONTHLY PARKING",P,"suffix"),
}

Names.FeatureTags = {
	noren="ramen", lattice="izakaya", awning="coffee", bakery="bakery",
	pharmacy="pharmacy", burger="burger", grille="burger", posterShop="konbini",
	stripe="konbini", localShop="localShop", produce="produce", hatch="takeaway",
	salon="salon", electronics="electronics", display="boutique", showroom="showroom",
	laundry="laundry", bicycle="bicycle", florist="florist", clinic="clinic",
	bookshop="bookshop", soba="soba", bathhouse="bathhouse", timberHouse="house",
}
Names.FixedChains = {
	fastFood={id="mcdoodoos",brand="McDooDoo's",japanese="",romanized="McDooDoo's",label="BURGERS"},
	kingBurger={id="smashKing",brand="SMASH KING",japanese="",romanized="SMASH KING",label="BURGERS"},
	coffeeChain={id="starboys",brand="STARBOYS",japanese="",romanized="STARBOYS",label="COFFEE"},
}

function Names.Seed(key)
	local h=5381
	key=tostring(key)
	for i=1,#key do h=(h*33+string.byte(key,i))%2147483647 end
	return h
end
local function compatible(row,category)
	for _,c in row.categories do if c==category then return true end end
	return false
end
local function find(rows,id)
	for _,r in rows do if r.id==id then return r end end
	return nil
end

function Names.Generate(category,keyOrSeed,options)
	options=options or {}
	category=category or "retail"
	local nameKey=tostring(options.nameSeed~=nil and options.nameSeed or keyOrSeed or "default")
	local feature=options.feature
	local fixed=Names.FixedChains[feature]
	if category=="chains" and not fixed then
		local keys={"fastFood","kingBurger","coffeeChain"}
		fixed=Names.FixedChains[keys[Random.new(Names.Seed(nameKey.."/chain")):NextInteger(1,#keys)]]
	end
	if fixed then
		return {brand=options.brandOverride or fixed.brand,japanese=fixed.japanese,romanized=fixed.romanized,
			label=fixed.label,subtitle=fixed.label,category="chains",labelId=fixed.id,stemId="fixed",
			identityKey="ground-name-v1/chains/"..fixed.id,nameSeed=nameKey}
	end
	local tag=options.tag or Names.FeatureTags[feature]
	local eligible={}
	for _,r in Names.Labelings do
		-- A specific feature takes precedence over a broad legacy family (salons
		-- and coffee are historically retail). It never mixes incompatible tags.
		if (tag and r.tag==tag) or (not tag and compatible(r,category)) then table.insert(eligible,r) end
	end
	assert(#eligible>0,"No facade name labelings for category/tag: "..category.."/"..tostring(tag))
	local chosen
	if options.labelId then chosen=find(eligible,options.labelId)
	else chosen=eligible[Random.new(Names.Seed(nameKey.."/label")):NextInteger(1,#eligible)] end
	assert(chosen,"Incompatible facade name labelId: "..tostring(options.labelId))
	local stem
	if options.stemId then stem=find(Names.Stems,options.stemId)
	else stem=Names.Stems[Random.new(Names.Seed(nameKey.."/stem")):NextInteger(1,#Names.Stems)] end
	assert(stem,"Unknown facade name stemId: "..tostring(options.stemId))
	local jp=chosen.format=="prefix" and (chosen.japanese.." "..stem.japanese) or (stem.japanese..chosen.japanese)
	local rom=stem.romanized.." "..chosen.english
	return {brand=options.brandOverride or (jp.." / "..rom),japanese=jp,romanized=rom,
		label=chosen.japanese,subtitle=chosen.english,category=category,labelId=chosen.id,stemId=stem.id,
		identityKey="ground-name-v1/"..chosen.id.."/"..stem.id,nameSeed=nameKey}
end

return Names
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">GroundFacadeDrafts</string>
          <string name="Source"><![CDATA[--!nonstrict
-- EDIT-TIME ONLY. Not wired into init.server. Never finds/edits live buildings.
-- require(game.ServerScriptService.Server.GroundFacadeDrafts).Generate()
local Shared=game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Kit=require(Shared.GroundFacadeKit)
local Catalog=require(Shared.GroundFacadeCatalog)
local Drafts={}
local ROOT="GroundFacadeDraftGallery"
local LIBRARY="GroundFacadeDraftLibrary"
local VERSION="2026-10-07-v1"

local function ownRoot(parent,name)
	local existing=parent:FindFirstChild(name)
	if existing then
		assert(existing:GetAttribute("GroundFacadeOwner")==VERSION,"Name is occupied by another object: "..name)
		return existing
	end
	local root=Instance.new("Folder");root.Name=name
	root:SetAttribute("GroundFacadeOwner",VERSION);root:SetAttribute("State","building");root.Parent=parent
	return root
end

local function part(parent,name,cf,size,color)
	local p=Instance.new("Part");p.Name=name;p.Anchored=true;p.Size=size;p.CFrame=cf;p.Color=color
	p.Material=Enum.Material.SmoothPlastic;p.CanTouch=false;p.TopSurface=Enum.SurfaceType.Smooth
	p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent
	return p
end

local function caption(parent,cf,width,value)
	local board=part(parent,"DraftCaption",cf,Vector3.new(width,2.2,0.2),Color3.fromRGB(25,30,35))
	local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Front;gui.PixelsPerStud=35
	gui.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud;gui.LightInfluence=0;gui.Parent=board
	local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1
	label.Text=value;label.TextColor3=Color3.fromRGB(231,220,197);label.Font=Enum.Font.SourceSansSemibold
	label.TextScaled=true;label.Parent=gui
end

local function illuminate(model)
	-- Review-only warm interior illumination; reusable facades carry no lights.
	local emitter=model:FindFirstChild("PreviewCeilingLight") or model:FindFirstChild("PreviewCeilingGlow")
	if emitter then
		local light=Instance.new("PointLight");light.Name="PreviewInteriorLight";light.Range=24
		light.Brightness=2;light.Color=Color3.fromRGB(242,224,198);light.Shadows=false;light.Parent=emitter
	end
end

function Drafts.Generate(origin)
	-- Acquire replay lock before creating any assets. Failed roots stay identifiable.
	local gallery=ownRoot(workspace,ROOT)
	if gallery:GetAttribute("State")=="ready" then
		assert(gallery:GetAttribute("Revision")==Catalog.VERSION,"Older gallery: use Upgrade() to archive and replace it")
		return gallery,game.ServerStorage:FindFirstChild(LIBRARY)
	end
	assert(#gallery:GetChildren()==0,"A draft build is incomplete; call Clear() before retrying")
	origin=origin or CFrame.new(0,1600,0)
	gallery:SetAttribute("Origin",origin)
	local library=ownRoot(game.ServerStorage,LIBRARY)
	assert(#library:GetChildren()==0 or (library:GetAttribute("State")=="ready" and library:GetAttribute("Revision")==Catalog.VERSION),"Older/incomplete library; use Upgrade()")
	local samples=Instance.new("Folder");samples.Name="01_IndividualTypes";samples.Parent=gallery
	local compositions=Instance.new("Folder");compositions.Name="02_StitchedExamples";compositions.Parent=gallery
	local stitchedZ=math.ceil(#Catalog.TYPES/5)*54+22
	local streetZ=stitchedZ+150
	local deckLength=streetZ+90
	gallery:SetAttribute("StreetViewZ",streetZ)
	part(gallery,"PreviewDeck",origin*CFrame.new(132,-0.55,(deckLength-60)/2),Vector3.new(366,1,deckLength),Color3.fromRGB(95,99,100))
	caption(gallery,origin*CFrame.new(132,38,stitchedZ-32),284,"GROUND FLOOR / "..#Catalog.TYPES.." SHIBUYA-INSPIRED DRAFTS")
	for i,spec in Catalog.TYPES do
		local column,row=(i-1)%5,math.floor((i-1)/5)
		local cf=origin*CFrame.new(column*66,0,row*54)
		local model=Kit.Build(samples,spec.id,cf,{seed=1000+i,vignette=true})
		illuminate(model)
		model.Name=spec.id
		caption(samples,cf*CFrame.new(0,(spec.height or 12.5)+3.5,1),spec.width+5,string.format("%02d / %s",i,spec.title))
		if not library:FindFirstChild(spec.id) then
			local template=Kit.Build(library,spec.id,CFrame.identity,{seed=1000+i});template.Name=spec.id
		end
	end
	for i,row in {{"mixed",96},{"office",96},{"hotel",96}} do
		local profile,width=row[1],row[2]
	local cf=origin*CFrame.new(-4+(i-1)*114,0,stitchedZ)
		local model=Kit.BuildRun(compositions,width,"draft-street-17/"..profile,profile,cf,{vignette=true,targetWidth=32})
		model.Name="Stitched_"..profile
		caption(compositions,cf*CFrame.new(0,16,1),width,"SEEDED / "..string.upper(profile))
	end
	-- Separate return wall demonstrates joining two runs around a corner.
	local corner=Instance.new("Model");corner.Name="Corner_Return";corner.Parent=compositions
	local cornerCF=origin*CFrame.new(-28,0,stitchedZ+55)
	Kit.BuildRun(corner,36,"draft-corner/front","retail",cornerCF,{vignette=false})
	Kit.BuildRun(corner,28,"draft-corner/return","alley",cornerCF*CFrame.new(18,0,14)*CFrame.Angles(0,math.rad(-90),0),{vignette=false})
	corner.WorldPivot=cornerCF
	caption(compositions,cornerCF*CFrame.new(0,16,1),42,"CORNER / FRONT + RETURN")
	-- Curated street context for reading adjacency. Entirely on this isolated preview deck.
	local street=Instance.new("Folder");street.Name="03_StreetView";street.Parent=gallery
	local streetCF=origin*CFrame.new(132,0,streetZ)
	part(street,"PreviewAsphalt",streetCF*CFrame.new(0,-.02,-25),Vector3.new(312,.15,32),Color3.fromRGB(54,57,60))
	part(street,"PreviewSidewalk",streetCF*CFrame.new(0,.05,-5),Vector3.new(312,.2,8),Color3.fromRGB(165,164,155))
	part(street,"PreviewCurb",streetCF*CFrame.new(0,.15,-9),Vector3.new(312,.3,.35),Color3.fromRGB(195,193,183))
	for x=-150,150,12 do part(street,"SidewalkJoint",streetCF*CFrame.new(x,.16,-5),Vector3.new(.05,.05,8),Color3.fromRGB(110,110,107)) end
	local ids={"16_ChainBurger","19_LocalShop","18_PosterKonbini","24_ConcreteSparse","26_BrickResidential","30_OpenGarage","27_TownhouseColumns","29_RaisedEntry","34_TwoStoreyGlass"}
	local total=0;for _,id in ids do total+=Catalog.Get(id).width end
	local cursor=-total/2
	for i,id in ids do
		local s=Catalog.Get(id);local cf=streetCF*CFrame.new(cursor+s.width/2,0,0)
		local model=Kit.Build(street,id,cf,{seed=800+i,adSeed=900+i,vignette=true,mirror=i%3==0,brand=Catalog.Brand(id,"street-view/"..i)})
		illuminate(model)
		model.Name="Street_"..id
		-- Quiet upper-floor silhouettes are preview set dressing, not an upper-floor kit.
		local base=(s.height or 12.5)+4.5;local rows=i%2+1
		local color=Catalog.PALETTES[s.palette].wall
		part(street,"PreviewUpperBody",cf*CFrame.new(0,base+rows*6.25,5),Vector3.new(s.width,rows*12.5,10),color)
		part(street,"PreviewFloorBand",cf*CFrame.new(0,base-2.25,5),Vector3.new(s.width,4.5,10),color)
		for row=1,rows do for x=-s.width/2+4,s.width/2-2,7 do
			local y=base+(row-.5)*12.5
			part(street,"PreviewUpperWindow",cf*CFrame.new(x,y,-.08),Vector3.new(3.8,5.6,.18),Color3.fromRGB(70,87,89))
			for _,edge in {-1,1} do
				part(street,"PreviewWindowJamb",cf*CFrame.new(x+edge*2,y,-.19),Vector3.new(.15,5.9,.2),Color3.fromRGB(134,137,133))
				part(street,"PreviewWindowRail",cf*CFrame.new(x,y+edge*2.9,-.19),Vector3.new(4.1,.15,.2),Color3.fromRGB(134,137,133))
			end
			if s.family=="residential" then
				part(street,"PreviewBalconySlab",cf*CFrame.new(x,y-3.1,-1.6),Vector3.new(5,.35,3.3),color)
				part(street,"PreviewBalconyTopRail",cf*CFrame.new(x,y-.8,-3),Vector3.new(5,.1,.12),Color3.fromRGB(85,80,72))
				for dx=-2.4,2.4,.6 do part(street,"PreviewBalconyBar",cf*CFrame.new(x+dx,y-1.95,-3),Vector3.new(.08,2.3,.1),Color3.fromRGB(85,80,72)) end
			end
		end end
		part(street,"PreviewDrainPipe",cf*CFrame.new(s.width/2-.55,(base+rows*12.5)/2,-.35),Vector3.new(.16,base+rows*12.5,.18),Color3.fromRGB(172,165,150))
		if s.family=="residential" then
			part(street,"PreviewACBox",cf*CFrame.new(-s.width/2+1.9,base+1.5,-.7),Vector3.new(2.7,1.7,1.0),Color3.fromRGB(196,191,177))
		end
		cursor+=s.width
	end
	gallery:SetAttribute("State","ready");library:SetAttribute("State","ready")
	gallery:SetAttribute("DraftTypes",#Catalog.TYPES)
	gallery:SetAttribute("Revision",Catalog.VERSION);library:SetAttribute("Revision",Catalog.VERSION)
	game:GetService("ChangeHistoryService"):SetWaypoint("Ground facade draft gallery")
	return gallery,library
end

function Drafts.Focus(id)
	local root=assert(workspace:FindFirstChild(ROOT),"Generate the gallery first")
	local camera=workspace.CurrentCamera
	if root:GetAttribute("PreviousCamera")==nil then
		root:SetAttribute("PreviousCamera",camera.CFrame);root:SetAttribute("PreviousCameraType",camera.CameraType.Name)
	end
	local origin=root:GetAttribute("Origin")
	local target=root:FindFirstChild("01_IndividualTypes"):FindFirstChild(id or "")
	camera.CameraType=Enum.CameraType.Scriptable
	if target and target:IsA("Model") then
		local cf=target:GetPivot()
		local h=target:GetAttribute("FacadeHeight") or 12.5
		camera.CFrame=CFrame.lookAt((cf*CFrame.new(-6,h*.8+3,-math.max(42,h*2))).Position,(cf*CFrame.new(0,h*.45,0)).Position)
		game:GetService("Selection"):Set({target})
	else
		camera.CFrame=CFrame.lookAt((origin*CFrame.new(132,270,-180)).Position,(origin*CFrame.new(132,5,230)).Position)
		game:GetService("Selection"):Set({root})
	end
end

function Drafts.FocusStreet()
	local root=assert(workspace:FindFirstChild(ROOT),"Generate gallery first")
	Drafts.Focus()
	local cf=root:GetAttribute("Origin")*CFrame.new(132,0,root:GetAttribute("StreetViewZ") or 550)
	workspace.CurrentCamera.CFrame=CFrame.lookAt((cf*CFrame.new(-42,7,-45)).Position,(cf*CFrame.new(-37,8,0)).Position)
	game:GetService("Selection"):Set({root:FindFirstChild("03_StreetView")})
end

function Drafts.Upgrade(origin)
	local root=workspace:FindFirstChild(ROOT)
	if root and root:GetAttribute("Revision")==Catalog.VERSION and root:GetAttribute("State")=="ready" then return Drafts.Generate() end
	local archive=game.ServerStorage:FindFirstChild("GroundFacadeDraftArchive")
	if archive then assert(archive:GetAttribute("GroundFacadeOwner")==VERSION,"Unowned archive")
	else archive=ownRoot(game.ServerStorage,"GroundFacadeDraftArchive") end
	local snapshot=Instance.new("Folder");snapshot.Name="BeforeRevision"..Catalog.VERSION.."_"..tostring(os.time());snapshot.Parent=archive
	for _,pair in {{workspace,ROOT},{game.ServerStorage,LIBRARY}} do
		local object=pair[1]:FindFirstChild(pair[2])
		if object then assert(object:GetAttribute("GroundFacadeOwner")==VERSION,"Unowned draft root");object:Clone().Parent=snapshot end
	end
	local oldOrigin=root and root:GetAttribute("Origin")
	-- Keep owner-placed spawns and the live glass demo across gallery replacement.
	local retained={}
	if root then for _,child in root:GetChildren() do
		if child:IsA("SpawnLocation") or child.Name=="04_GlassDemo" then child.Parent=game.ServerStorage;table.insert(retained,child) end
	end end
	Drafts.Clear()
	local gallery,library=Drafts.Generate(origin or oldOrigin)
	for _,child in retained do child.Parent=gallery end
	return gallery,library
end

function Drafts.RestoreCamera()
	local root=workspace:FindFirstChild(ROOT)
	if root and root:GetAttribute("PreviousCamera") then
		workspace.CurrentCamera.CFrame=root:GetAttribute("PreviousCamera")
		workspace.CurrentCamera.CameraType=Enum.CameraType[root:GetAttribute("PreviousCameraType")]
		root:SetAttribute("PreviousCamera",nil);root:SetAttribute("PreviousCameraType",nil)
	end
end

function Drafts.Clear()
	Drafts.RestoreCamera()
	for _,pair in {{workspace,ROOT},{game.ServerStorage,LIBRARY}} do
		local root=pair[1]:FindFirstChild(pair[2])
		if root then
			assert(root:GetAttribute("GroundFacadeOwner")==VERSION,"Refusing to clear unowned object")
			root:Destroy()
		end
	end
end
return Drafts
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="11">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
