{
  "name": "JJK_Roblox",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$ignoreUnknownInstances": true,
      "R15Dummy": {
        "$path": "assets/R15Dummy.rbxm"
      },
      "CoreDeco": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Furniture": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 256,
        "CharacterJumpPower": 512
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "$ignoreUnknownInstances": true
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}